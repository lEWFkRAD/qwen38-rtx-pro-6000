+    def _slot_queue_batch(self) -> int:
+        """The batch-slot count the slot queue gates at, or 0 (off): STRATA_SLOT_QUEUE=1 and a parallel engine.
+        Read per request, so an engine restart with a different slot count re-gates on the next request, and
+        unsetting the env var restores the pristine behaviour exactly (no gate at all)."""
+        if os.environ.get("STRATA_SLOT_QUEUE") != "1":
+            return 0
+        return int(getattr(self.engine, "batch", 0) or 0)
+
+    def _slot_gate_for(self, batch: int) -> threading.BoundedSemaphore:
+        """The gate for `batch` slots, made (or remade, when the engine's slot count changed) under a lock.
+        Requests already admitted hold the gate object they took, so a remake never strands their release."""
+        with self._slot_gate_lock:
+            if self._slot_gate is None or self._slot_gate[0] != batch:
+                self._slot_gate = (batch, threading.BoundedSemaphore(batch))
+            return self._slot_gate[1]
+
