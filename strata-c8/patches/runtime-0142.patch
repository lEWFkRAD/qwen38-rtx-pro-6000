+    def _yield_due(self, plen: int, yields: int, leg_from: int) -> bool:
+        """Whether the prompt read on the control lines gives way at this chunk boundary.
+        #656 (always, the fast path): a waiting prompt under half this one's, at most YIELDS_MAX times.
+        Admission rotation (STRATA_ADMIT_ROTATE=1): any admission waiting, once this leg has read a
+        quantum (STRATA_ADMIT_ROTATE_QUANTUM tokens, default 16384 = one chunk) since it (re)started
+        or last gave way, up to YIELDS_ROTATE_MAX times - comparable lengths take turns instead of
+        queueing behind each other.  A park+resume cycle costs ~0.3 s at a 16K park (~0.73 s at 35K),
+        so the quantum floor keeps it a small part of the leg it interrupts.  `leg_from`: the tokens
+        of this prompt read before this leg (the last yield's count; progress counts from 0)."""
+        if yields < self.YIELDS_MAX and self._shorter_waiting(plen):
+            return True
+        if os.environ.get("STRATA_ADMIT_ROTATE") != "1" or yields >= self.YIELDS_ROTATE_MAX:
+            return False
+        if not self._any_waiting():
+            return False
+        try:
+            quantum = max(1, int(os.environ.get("STRATA_ADMIT_ROTATE_QUANTUM", "16384")))
+        except ValueError:
+            quantum = 16384
+        return self.progress is not None and self.progress[0] - leg_from >= quantum
