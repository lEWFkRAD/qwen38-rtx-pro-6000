+    const int64_t t0 = (int64_t) blockIdx.x * FDS_T, n0 = (int64_t) blockIdx.y * FDS_N;
+    const int r0 = tid >> 3, r1 = r0 + 8, k4 = (tid & 7) << 2;
+    const float* x0 = x + min(t0 + r0, T - 1) * K + k4;
+    const float* x1 = x + min(t0 + r1, T - 1) * K + k4;
+    const float* w0 = w + min(n0 + r0, N - 1) * K + k4;
+    const float* w1 = w + min(n0 + r1, N - 1) * K + k4;
+    const int nk = (int) (K / FDF_K);
+
+    auto load = [&](int st, int ks) {
+        const int64_t off = (int64_t) ks * FDF_K;
+        fdf_cp16(&xs[st][r0][k4], x0 + off);
+        fdf_cp16(&xs[st][r1][k4], x1 + off);
+        fdf_cp16(&ws[st][r0][k4], w0 + off);
+        fdf_cp16(&ws[st][r1][k4], w1 + off);
+        asm volatile("cp.async.commit_group;\n" ::);
+    };
+
+    float acc00 = 0.f, acc01 = 0.f, acc10 = 0.f, acc11 = 0.f;
+    load(0, 0);
+    if (nk > 1) load(1, 1);
+    for (int ks = 0; ks < nk; ++ks) {
+        if (ks + 1 < nk) asm volatile("cp.async.wait_group 1;\n" ::);
+        else asm volatile("cp.async.wait_group 0;\n" ::);
+        __syncthreads();
+        if (ks + 2 < nk) load((ks + 2) % FDF_ST, ks + 2);
