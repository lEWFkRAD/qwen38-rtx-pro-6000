+constexpr int kAScale32 = kTile32 * kKTile / 16;   // 256
+constexpr int kAStage32 = kACode32 + kAScale32;    // 2304
+constexpr int kStages3 = 3;
+constexpr int kSmem128_3s = kStages3 * (2 * kAStage32 + kBStage);   // 44544 bytes
