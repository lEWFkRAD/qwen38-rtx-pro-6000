+// and exact sequential k = 0..K-1 fmaf order (bitwise identical to f32_rows_dot_kernel).
+constexpr int FDF_K = 32, FDF_ST = 3, FDF_LD = 36;
+__device__ __forceinline__ void fdf_cp16(void* dst, const void* src) {
+    asm volatile("cp.async.ca.shared.global [%0], [%1], 16;\n" ::"r"((unsigned) __cvta_generic_to_shared(dst)), "l"(src));
+}
+__global__ void __launch_bounds__(64, 4) f32_rows_dot_fast_kernel(const float* __restrict__ x, const float* __restrict__ w,
+                                                                  float* __restrict__ y, int64_t T, int64_t N, int64_t K) {
+    __shared__ __align__(16) float xs[FDF_ST][FDS_T][FDF_LD];
+    __shared__ __align__(16) float ws[FDF_ST][FDS_N][FDF_LD];
