+void bench_q8_planes_mmvq(const char* name, int M, int K, bool segmented) {
+    namespace bk = basalt::kernels;
+    const size_t plane_bytes = (size_t) M * K + (size_t) M * (K / 32) * 2;
+    const int copies = (int) std::max<size_t>(2, (512u << 20) / plane_bytes + 1);
+    std::vector<void*> planes((size_t) copies);
+    for (void*& p : planes) {
+        ck(cudaMalloc(&p, plane_bytes), "bench planes");
+        ck(cudaMemset(p, 0, plane_bytes), "bench planes zero");
+    }
+    const size_t q8 = (size_t) 8 * (K / 32) * 36;
+    const size_t q16 = 2 * q8;
+    void* x = nullptr;
+    float* y = nullptr;
+    ck(cudaMalloc(&x, (segmented ? 3 : 1) * q16), "bench x");
+    ck(cudaMemset(x, 1, (segmented ? 3 : 1) * q16), "bench x fill");
+    ck(cudaMalloc(&y, (size_t) 16 * M * sizeof(float)), "bench y");
+    cudaStream_t st = nullptr;
+    ck(cudaStreamCreate(&st), "bench stream");
+    cudaEvent_t e0 = nullptr, e1 = nullptr;
+    ck(cudaEventCreate(&e0), "bench event 0");
+    ck(cudaEventCreate(&e1), "bench event 1");
+    bk::PdlScope pdl(true);
+
+    auto call = [&](int wi, int T, bool split) {
+        if (!segmented) {
+            bk::native_q8_planes_mmvq(planes[(size_t) wi], x, y, K, M, split ? 8 : T, st);
+            if (split)
+                bk::native_q8_planes_mmvq(planes[(size_t) wi], static_cast<uint8_t*>(x) + q8,
+                                          y + (size_t) 8 * M, K, M, T - 8, st);
+            return;
+        }
+        bk::Q80Segments sg;
+        sg.n = 3;
+        sg.row0[0] = 0;    sg.n_out[0] = 6552;
+        sg.row0[1] = 6552; sg.n_out[1] = 1056;
+        sg.row0[2] = 7608; sg.n_out[2] = 1056;
+        for (int k = 0; k < 3; ++k) sg.x[k] = static_cast<uint8_t*>(x) + (size_t) k * q16;
+        sg.y[0] = y; sg.y[1] = y + 16 * 6552; sg.y[2] = y + 16 * 7608;
+        bk::native_q8_planes_mmvq_segments(planes[(size_t) wi], M, sg, K, split ? 8 : T, st);
+        if (split) {
+            for (int k = 0; k < 3; ++k) {
+                sg.x[k] = static_cast<const uint8_t*>(sg.x[k]) + q8;
+                sg.y[k] += (size_t) 8 * sg.n_out[k];
+            }
+            bk::native_q8_planes_mmvq_segments(planes[(size_t) wi], M, sg, K, T - 8, st);
+        }
+    };
+    auto time = [&](int T, bool split) {
+        int wi = 0;
+        for (int i = 0; i < copies; ++i) call(wi++ % copies, T, split);
+        const int n = 6 * copies;
+        ck(cudaEventRecord(e0, st), "bench record 0");
+        for (int i = 0; i < n; ++i) call(wi++ % copies, T, split);
+        ck(cudaEventRecord(e1, st), "bench record 1");
+        ck(cudaEventSynchronize(e1), "bench sync");
+        float ms = 0.0f;
+        ck(cudaEventElapsedTime(&ms, e0, e1), "bench elapsed");
+        return 1000.0 * (double) ms / n;
+    };
+    for (int T = 9; T <= 16; ++T) {
+        const double split_us = time(T, true);
+        const double fused_us = time(T, false);
+        std::printf("Q8-plane %-23s T=%2d  split=%7.1f us  fused=%7.1f us  speedup=%5.3fx  fused=%5.0f GB/s\n",
+                    name, T, split_us, fused_us, split_us / fused_us, plane_bytes / fused_us / 1e3);
+    }
+    cudaEventDestroy(e0); cudaEventDestroy(e1); cudaStreamDestroy(st);
+    cudaFree(x); cudaFree(y);
+    for (void* p : planes) cudaFree(p);
+}
