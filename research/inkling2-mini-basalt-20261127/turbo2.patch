+// The vocabulary head is the sole raw-Q8_0 product wider than eight columns.  This separate body keeps the <= 8
+// kernel above unchanged, while reusing each 16-row weight tile for two independent groups of eight activation
+// columns.  Within either group it deliberately repeats q80_mma_body's chain, fold and butterfly order exactly.
+__device__ __forceinline__ void q80_mma_wide_body(const Q80Block* __restrict__ w,
+                                                  const Q81Block* __restrict__ x, float* __restrict__ y, int n_in,
+                                                  int n_out, int ncols, int bx) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 800
+    __shared__ float s_part[16 * 16 * 33];
+    const int wp = threadIdx.x >> 5, lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
+    const int row0 = bx * 16, nb = n_in / 32;
+    const Q80Block* wa = w + (size_t) min(row0 + g, n_out - 1) * nb;
+    const Q80Block* wb = w + (size_t) min(row0 + g + 8, n_out - 1) * nb;
+    auto load_a = [&](int kbx) {
+        QmA r;
+        r.a0 = load_int_b2(wa[kbx].qs, t);
+        r.a2 = load_int_b2(wa[kbx].qs, 4 + t);
+        r.a1 = load_int_b2(wb[kbx].qs, t);
+        r.a3 = load_int_b2(wb[kbx].qs, 4 + t);
+        r.da = wa[kbx].d;
+        r.db = wb[kbx].d;
+        return r;
+    };
+    QmA pre[3];
+#pragma unroll
+    for (int j = 0; j < 3; ++j)
+        if (wp + 32 * j < nb) pre[j] = load_a(wp + 32 * j);
+    pdl_launch_dependents();
+    pdl_wait();
+    const Q81Block* xg[2];
+    const Q81Block* xc0[2];
+    const Q81Block* xc1[2];
+#pragma unroll
+    for (int z = 0; z < 2; ++z) {
+        const int base = 8 * z;
+        xg[z] = x + (size_t) min(base + g, ncols - 1) * nb;
+        xc0[z] = x + (size_t) min(base + 2 * t, ncols - 1) * nb;
+        xc1[z] = x + (size_t) min(base + 2 * t + 1, ncols - 1) * nb;
+    }
+    float v[2][4][4];
+    const bool lo = t < 2;
+    auto block = [&](const QmA& A, int kbx, float (&acc)[2][4][4]) {
+#pragma unroll
+        for (int z = 0; z < 2; ++z) {
+            const int base = 8 * z;
+            const uint32_t b0 = base + g < ncols ? (uint32_t) reinterpret_cast<const int*>(xg[z][kbx].qs)[t] : 0u;
+            const uint32_t b1 =
+                base + g < ncols ? (uint32_t) reinterpret_cast<const int*>(xg[z][kbx].qs)[4 + t] : 0u;
+            const float dx0 = __low2float(xc0[z][kbx].ds), dx1 = __low2float(xc1[z][kbx].ds);
+#pragma unroll
+            for (int grp = 0; grp < 4; ++grp) {
+                const bool mine = (grp & 1) ? !lo : lo, hi = grp >= 2;
+                const uint32_t m0 = mine && !hi ? (uint32_t) A.a0 : 0u;
+                const uint32_t m1 = mine && !hi ? (uint32_t) A.a1 : 0u;
+                const uint32_t m2 = mine && hi ? (uint32_t) A.a2 : 0u;
+                const uint32_t m3 = mine && hi ? (uint32_t) A.a3 : 0u;
+                int si[4];
+                qm_mma(si, m0, m1, m2, m3, b0, b1);
+                acc[z][grp][0] += A.da * dx0 * float(si[0]);
+                acc[z][grp][1] += A.da * dx1 * float(si[1]);
+                acc[z][grp][2] += A.db * dx0 * float(si[2]);
+                acc[z][grp][3] += A.db * dx1 * float(si[3]);
+            }
+        }
+    };
+#pragma unroll
+    for (int yy = 0; yy < 4; ++yy) {
+        float acc[2][4][4];
+#pragma unroll
+        for (int z = 0; z < 2; ++z)
+#pragma unroll
+            for (int a = 0; a < 4; ++a)
+#pragma unroll
+                for (int q = 0; q < 4; ++q) acc[z][a][q] = 0.0f;
+        const int c = 8 * yy + wp;
+        if (yy == 0) {
+#pragma unroll
+            for (int j = 0; j < 3; ++j)
+                if (c + 32 * j < nb) block(pre[j], c + 32 * j, acc);
+            for (int kbx = c + 96; kbx < nb; kbx += 32) block(load_a(kbx), kbx, acc);
+        } else {
+            for (int kbx = c; kbx < nb; kbx += 32) block(load_a(kbx), kbx, acc);
+        }
+#pragma unroll
+        for (int z = 0; z < 2; ++z)
+#pragma unroll
+            for (int a = 0; a < 4; ++a)
+#pragma unroll
+                for (int q = 0; q < 4; ++q) v[z][a][q] = yy == 0 ? acc[z][a][q] : v[z][a][q] + acc[z][a][q];
+    }
+#pragma unroll
+    for (int z = 0; z < 2; ++z)
+#pragma unroll
+        for (int grp = 0; grp < 4; ++grp)
+#pragma unroll
+            for (int q = 0; q < 4; ++q) {
+                const int row = g + 8 * (q >> 1), col = 8 * z + 2 * t + (q & 1);
+                if (col < ncols) s_part[(col * 16 + row) * 33 + 4 * wp + grp] = v[z][grp][q];
+            }
+    __syncthreads();
+    if ((int) threadIdx.x < 16 * ncols) {
+        const int row = threadIdx.x % 16, col = threadIdx.x / 16;
+        const float* p = s_part + (col * 16 + row) * 33;
+        float r16[16], r8[8], r4[4];
+#pragma unroll
+        for (int L = 0; L < 16; ++L) r16[L] = p[L] + p[L + 16];
+#pragma unroll
+        for (int L = 0; L < 8; ++L) r8[L] = r16[L] + r16[L + 8];
+#pragma unroll
+        for (int L = 0; L < 4; ++L) r4[L] = r8[L] + r8[L + 4];
+        const float r2a = r4[0] + r4[2], r2b = r4[1] + r4[3];
+        if (row0 + row < n_out) y[(size_t) col * n_out + row0 + row] = r2a + r2b;
+    }
+#elif defined(__CUDA_ARCH__)
+    __trap();
+#endif
+}
