+#pragma unroll
+                for (int g = 0; g < G; ++g) {
+                    acc[g] = fmaf(w[g][c].x, v.x, acc[g]);
+                    acc[g] = fmaf(w[g][c].y, v.y, acc[g]);
+                    acc[g] = fmaf(w[g][c].z, v.z, acc[g]);
+                    acc[g] = fmaf(w[g][c].w, v.w, acc[g]);
+                }
