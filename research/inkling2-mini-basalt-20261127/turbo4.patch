+// 2-row-per-block decode/prefill logits kernel for n_embd <= 4 * NV * kLogitThreads.
+// Each (row, token) sum runs in exact router_logits_row order (c=0..NV-1, x/y/z/w fmaf, warp_sum, warp 0..7) so bits match.
+template <int NV, int G, int NT_MAX>
+__global__ void __launch_bounds__(kLogitThreads)
+router_logits_opt_kernel(const float* __restrict__ x, const float* __restrict__ gate, int n_embd, int n_expert,
+                         int n_tokens, float* __restrict__ logits) {
+    __shared__ float red[G][NT_MAX * (kLogitThreads / 32)];
+    const int n4 = n_embd >> 2;
+    const int r0 = blockIdx.x * G;
+    const int t0 = blockIdx.y * NT_MAX;
+    const int nt = min(NT_MAX, n_tokens - t0);
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    float4 w[G][NV];
+#pragma unroll
+    for (int g = 0; g < G; ++g) {
+        const float4* gp = reinterpret_cast<const float4*>(gate + (size_t) (r0 + g) * n_embd);
+#pragma unroll
+        for (int c = 0; c < NV; ++c) {
+            const int i = threadIdx.x + c * kLogitThreads;
+            if (i < n4) w[g][c] = __ldg(gp + i);
+        }
+    }
+    pdl_wait();
+    pdl_launch_dependents();
+#pragma unroll
+    for (int t = 0; t < NT_MAX; ++t) {
+        if (t >= nt) break;
+        const float4* xv = reinterpret_cast<const float4*>(x + (size_t) (t0 + t) * n_embd);
+        float acc[G];
+#pragma unroll
+        for (int g = 0; g < G; ++g) acc[g] = 0.f;
+#pragma unroll
+        for (int c = 0; c < NV; ++c) {
+            const int i = threadIdx.x + c * kLogitThreads;
+            if (i < n4) {
