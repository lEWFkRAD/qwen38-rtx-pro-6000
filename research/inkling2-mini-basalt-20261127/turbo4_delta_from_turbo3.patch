+// Extract s[lane] using compile-time constant indices so s[] stays strictly in registers (0 local-memory stack).
+template<int NC>
+__device__ __forceinline__ float pick_lane(const float (&s)[NC], int lane) {
+    float v = s[0];
+#pragma unroll
+    for (int c = 1; c < NC; ++c)
+        if (lane == c) v = s[c];
+    return v;
+}
+
+// 4 consecutive rows per warp (32 rows per 256-thread block = 1 q8_1 block of hq): NVFP4 gate + up (KC = 144,
+// n_embd = 2304) followed by bit-exact softcapped SwiGLU into hsh[entry][row_in_32].
+template<int NC, bool EXACT_N>
+__device__ __forceinline__ void gu_softcap_4rows_nvfp4(const uint8_t* __restrict__ blob, size_t up_off, size_t gu_row,
+                                                       int r0, int warp, int lane, const block_q8_1* __restrict__ xq,
+                                                       const int (&off)[NC], int n, float sc_g, float sc_u, float cg,
+                                                       float cu, float (&hsh)[8][33]) {
+    constexpr int kNb = 2304 / Fmt<40>::qk;   // 36
+    constexpr int kKc = 144;
+#pragma unroll 1
+    for (int p = 0; p < 4; ++p) {
+        float gv = 0.0f, uv = 0.0f;
+#pragma unroll 1
+        for (int side = 0; side < 2; ++side) {
+            // Stop LICM from hoisting xq + off[c] addresses/loads across the (p, side) loops into ~80+ live regs.
+            const block_q8_1* xq_cur = xq;
+            asm("" : "+l"(xq_cur));
+            const uint8_t* w = blob + (side == 0 ? (size_t) 0 : up_off) + (size_t) (r0 + p * 8 + warp) * gu_row;
+            float s[NC];
+            row_dot_multi<40, NC, EXACT_N, false, kKc>(w, xq_cur, off, n, kNb, lane, s, nullptr);
+            tail_scale<40>(s, side == 0 ? sc_g : sc_u);
+            const float v = pick_lane(s, lane);
+            if (side == 0) gv = v;
+            else uv = v;
+        }
+        if (EXACT_N ? (lane < NC) : (lane < n)) {
+            const float h = __fmul_rn(__fmul_rn(cg * tanhf(gv / cg), 1.0f / (1.0f + expf(-gv))), cu * tanhf(uv / cu));
+            hsh[lane][p * 8 + warp] = h;
+        }
+    }
+}
