+struct TmaCacheEntry {
+    const void* base = nullptr;
+    int64_t rows = 0, cols = 0;
+    int box_rows = 0;
+    TmaDesc desc{};
+};
+
+void tmap_cached(TmaDesc* out, const void* base, int64_t rows, int64_t cols, int box_rows) {
+    constexpr size_t kCap = 256;
+    thread_local TmaCacheEntry cache[kCap];
+    const uint64_t h = (uint64_t) (uintptr_t) base ^ ((uint64_t) rows * 0x9e3779b97f4a7c15ull) ^
+                       ((uint64_t) cols << 17) ^ ((uint64_t) box_rows << 3);
+    const size_t idx = (size_t) ((h ^ (h >> 12) ^ (h >> 24)) & (kCap - 1));
+    TmaCacheEntry& e = cache[idx];
+    if (e.base == base && e.rows == rows && e.cols == cols && e.box_rows == box_rows) {
+        *out = e.desc;
+        return;
+    }
+    tmap(out, base, rows, cols, box_rows);
+    e.base = base;
+    e.rows = rows;
+    e.cols = cols;
+    e.box_rows = box_rows;
+    e.desc = *out;
+}
