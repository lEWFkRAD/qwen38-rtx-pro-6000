+template <int BT_T, int WT_T, int WR_T, bool MULTI_ACT>
+void launch_q8_kernel(const Args& p, unsigned grid, cudaStream_t s) {
+    constexpr int SMEM_T = ST * BT_T * BK + W_B + ST * 4 * BT_T * (int) sizeof(float) + WSC_B + 3 * ST * 8;
+    static std::atomic<bool> configured[64];
+    int dev = 0;
+    cudaGetDevice(&dev);
+    if (dev >= 0 && dev < 64 && !configured[dev].load(std::memory_order_acquire)) {
+        cudaFuncSetAttribute(gemm_kernel_t<BT_T, WT_T, WR_T, MULTI_ACT>, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM_T);
+        configured[dev].store(true, std::memory_order_release);
+    }
+    gemm_kernel_t<BT_T, WT_T, WR_T, MULTI_ACT><<<grid, NT, SMEM_T, s>>>(p);
+    ck("gemm");
+}
+
+void gemm_impl(const Segment* seg, const void* const* acts, int nseg, bool multi_act, int64_t w_cols, int64_t rows,
+               Epilogue epi, void* stream) {
+    if (rows <= 0 || nseg < 1) return;
+    if (nseg > MAX_SEG || w_cols % 64 != 0) {
+        basalt::log::error("basalt", "prefill q8: %d segments of %lld columns", nseg, (long long) w_cols);
+        std::exit(1);
+    }
+    static const bool q8_opt = [] { const char* e = std::getenv("BASALT_Q8_PREFILL_OPT"); return !e || e[0] != '0'; }();
+    const bool use_bt32 = q8_opt && rows <= 384;
+    const int bt = use_bt32 ? 32 : 64;
+    Args p{};
+    const int n_act = multi_act ? nseg : 1;
+    for (int i = 0; i < n_act; ++i) {
+        tmap_cached(&p.tm_a[i], acts[i], rows, w_cols, bt);
+        p.a_scale[i] = reinterpret_cast<const float*>(static_cast<const uint8_t*>(acts[i]) + scale_off(rows, w_cols));
+    }
+    int tiles = 0;
+    for (int i = 0; i < nseg; ++i) {
+        const Segment& s = seg[i];
+        if (s.rows <= 0 || s.rows % 2 != 0 || !s.w_scales_t || ((uintptr_t) s.w & 15) != 0 ||
+            ((uintptr_t) s.w_scales_t & 15) != 0 || ((uintptr_t) s.dst & 7) != 0 || s.ld_dst % 2 != 0 ||
+            s.ld_dst < s.rows) {
+            basalt::log::error("basalt", "prefill q8: segment %d: [%lld x %lld] matrix, ld %lld", i, (long long) s.rows,
+                               (long long) w_cols, (long long) s.ld_dst);
+            std::exit(1);
+        }
+        tmap_cached(&p.tm_w[i], s.w, s.rows, w_cols, BR);
+        p.seg[i] = {reinterpret_cast<const __half*>(s.w_scales_t), s.dst, s.ld_dst, (int) s.rows,
+                    (int) scale_plane_ld(s.rows), tiles};
+        tiles += (int) ((s.rows + BR - 1) / BR);
+    }
+    p.nseg = nseg;
+    p.ntok = (int) rows;
+    p.tok_tiles = (int) ((rows + bt - 1) / bt);
+    p.total_tiles = tiles;
+    p.k_tiles = (int) ((w_cols + BK - 1) / BK);
+    p.k_blocks = (int) (w_cols >> 5);
+    p.a_sc_ld = (int) act_scale_ld(rows);
+    p.epi = (int) epi;
+    const unsigned grid = (unsigned) (tiles * p.tok_tiles);
+    const cudaStream_t s = (cudaStream_t) stream;
+    if (use_bt32) {
+        if (multi_act) launch_q8_kernel<32, 1, 4, true>(p, grid, s);
+        else launch_q8_kernel<32, 1, 4, false>(p, grid, s);
+    } else {
+        if (multi_act) launch_q8_kernel<64, 2, 2, true>(p, grid, s);
+        else launch_q8_kernel<64, 2, 2, false>(p, grid, s);
+    }
+}
