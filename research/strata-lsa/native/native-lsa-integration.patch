diff --git a/include/strata/lsa/cache_state.hpp b/include/strata/lsa/cache_state.hpp
new file mode 100644
index 00000000..d94fc544
--- /dev/null
+++ b/include/strata/lsa/cache_state.hpp
@@ -0,0 +1,116 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace strata::lsa {
+
+// Metadata contract for the experimental learned-map cache. This class owns no
+// device buffers and is not wired into Strata's sessions. The adapter must apply
+// each returned invalidation to its own projected keys, clusters and members
+// before using a slot again. Calls are serialized by the session owner.
+//
+// The pilot maps consume the trailing 192 nonrotary coordinates of each of two
+// 256-wide KV heads, concatenated in head order. Keys are dequantized INT8-cache
+// values. Queries sum the 12 matching Q heads within each KV group before the
+// same concatenation. The separate query/key 384x64 maps project these inputs;
+// normalize each projected row. Temperature remains separate from both maps.
+class CacheState {
+public:
+    static constexpr uint32_t kContext = 131072;
+    static constexpr uint32_t kSlots = 8;
+    static constexpr uint32_t kLayers = 12;
+    static constexpr uint32_t kInputDim = 384;
+    static constexpr uint32_t kIndexDim = 64;
+    static constexpr uint32_t kBlockTokens = 512;
+    static constexpr uint32_t kWindowTokens = 512;
+    static constexpr uint32_t kSinkTokens = 4;
+
+    struct Ticket {
+        uint32_t slot = 0;
+        uint64_t generation = 0;
+        uint32_t base_tokens = 0;
+    };
+
+    struct AppendRange {
+        uint32_t begin_token;
+        uint32_t end_token;          // exclusive
+        uint32_t first_new_block;    // previously incomplete block
+        uint32_t end_complete_block; // exclusive; provisional until commit
+    };
+
+    struct Transition {
+        uint32_t old_tokens;
+        uint32_t new_tokens;
+        uint32_t published_blocks_before;
+        uint32_t published_blocks_after;
+        uint32_t discard_from_token;
+        uint32_t discard_from_block;
+        uint64_t generation;
+    };
+
+    struct View {
+        uint32_t visible_tokens; // exactly query_position + 1, never future KV
+        uint32_t complete_blocks;
+        // Rank only these blocks (64 buckets per block): floor(position / 512).
+        // The block containing this query remains unranked even when its final
+        // token has just made it complete. This is not complete_blocks, nor the
+        // number of blocks wholly before the local window. Expansion still
+        // filters each selected member by long_range_end; at position 1536 the
+        // third ranked block can contribute key 1024 across that window edge.
+        uint32_t selectable_blocks;
+        uint32_t published_blocks;
+        uint32_t provisional_blocks;
+        uint32_t tail_begin;
+        uint32_t tail_tokens;
+        uint32_t long_range_end; // exclusive; expansion must filter by this
+        uint32_t long_range_complete_blocks;
+    };
+
+    static uint32_t layer_ordinal(uint32_t model_layer);
+
+    // begin never publishes speculative data. Only the matching live ticket can
+    // observe its appends; the ordinary slot view remains at committed_tokens.
+    Ticket begin(uint32_t slot);
+    AppendRange append(const Ticket& ticket, uint32_t model_layer, uint32_t count);
+
+    // All layers must have appended the same speculative length before a commit.
+    // Only the accepted prefix is published. Everything after it is invalidated,
+    // including a partly accepted 512-token block's provisional cluster state.
+    Transition accept_prefix(const Ticket& ticket, uint32_t accepted_tokens);
+    Transition reject(const Ticket& ticket); // also accepts an incomplete forward
+
+    // Reuse of the SAME stored KV prefix, not a declaration that another prompt
+    // matches it. Also abandons any open transaction and invalidates its ticket.
+    // Dropping a partial block invalidates that block and every later block.
+    Transition truncate(uint32_t slot, uint32_t retained_tokens);
+    Transition reset(uint32_t slot);
+
+    uint32_t committed_tokens(uint32_t slot) const;
+    uint32_t available_tokens(const Ticket& ticket, uint32_t model_layer) const;
+    uint32_t published_blocks(uint32_t slot) const;
+    bool transaction_open(uint32_t slot) const;
+    uint64_t generation(uint32_t slot) const;
+
+    View view(uint32_t slot, uint32_t model_layer, uint32_t query_position) const;
+    View view(const Ticket& ticket, uint32_t model_layer, uint32_t query_position) const;
+
+private:
+    struct Slot {
+        uint32_t committed = 0;
+        uint64_t generation = 0;
+        bool open = false;
+        std::array<uint32_t, kLayers> appended{};
+    };
+    std::array<Slot, kSlots> slots_{};
+
+    Slot& slot_at(uint32_t slot);
+    const Slot& slot_at(uint32_t slot) const;
+    Slot& live(const Ticket& ticket);
+    const Slot& live(const Ticket& ticket) const;
+    static View make_view(uint32_t committed, uint32_t available, uint32_t query_position);
+    static void bump(Slot& slot);
+    static Transition finish(Slot& slot, uint32_t new_tokens);
+};
+
+} // namespace strata::lsa
diff --git a/include/strata/lsa/cuda_adapter.h b/include/strata/lsa/cuda_adapter.h
new file mode 100644
index 00000000..de17a200
--- /dev/null
+++ b/include/strata/lsa/cuda_adapter.h
@@ -0,0 +1,66 @@
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+// Research-only CUDA bridge. No engine path calls this API. All device buffers
+// are caller-owned and must remain alive until the explicit stream completes.
+// No allocation or synchronization occurs during projection/selection/attention.
+// Geometry is Flash-Next INT8 KV, 24 Q heads, 2 KV heads, 256 coordinates,
+// trailing 192 nonrotary coordinates, learned 384 x 64 row-major FP32 maps.
+// Returns cudaError_t as int. Inputs must be finite. Projection ignores invalid
+// page IDs defensively. Native attention requires validated page and cell tables;
+// its existing reader does not validate physical allocation bounds.
+#ifdef __cplusplus
+extern "C" {
+#endif
+// Startup/teardown only: strictly load the native map artifact and copy weights
+// to persistent device storage. These calls allocate and synchronize. Getter
+// pointers are borrowed until close, and layer is the model layer (3,7,...,47).
+// A handle belongs to the CUDA device/context current at open. Keep that device
+// current for its use and close; finish every stream and destroy captured graphs
+// referencing its weights before close. No reference-counted lifetime is implied.
+void* lsa_maps_open(const char* path, char* error, size_t error_capacity);
+const float* lsa_maps_query(void* handle, int layer);
+const float* lsa_maps_key(void* handle, int layer);
+float lsa_maps_temperature(void* handle, int layer);
+// Immutable full-byte FNV-1a 64 identity of the artifact actually loaded by open.
+// Cache compatibility only, not authentication. Null handle returns zero.
+uint64_t lsa_maps_identity(void* handle);
+void lsa_maps_close(void* handle);
+int lsa_project_keys(const int8_t* codes, const uint16_t* scales,
+                     const int32_t* page_table, int physical_pages, int page_size,
+                     int start, int count, const float* map, float* output, void* stream);
+// Capturable decode/verification form: positions are read from device memory.
+// Fully resident KV only: page_table has physical_pages logical entries and
+// pools have physical_pages pages. Positions outside that span produce zeros.
+int lsa_project_key_steps(const int8_t* codes, const uint16_t* scales,
+                          const int32_t* page_table, int physical_pages, int page_size,
+                          const int32_t* positions, int count, const float* map,
+                          float* output, void* stream);
+int lsa_project_queries(const float* query, int count, const float* map,
+                        float* output, void* stream);
+// Queries and centroids are FP32 storage of BF16-rounded normalized vectors.
+// The index covers closed 512-token blocks: 64 buckets/block, 16 members/bucket.
+// Members partition their blocks, are ordered, unique and -1 padded. Selection
+// masks each row by its device position; equal packed score bits resolve toward
+// lower bucket IDs. Signed zeros follow the pinned upstream packed-key ordering.
+// Capacity <= 16384 buckets (131072 context), <= 128 queries. top_p is 385.
+// Single-row calls sort only the device-position-visible prefix; the buffers
+// and temporary-storage requirement still use buckets capacity. Multirow calls
+// retain their capacity-strided segments. Empty visible prefixes are valid.
+int lsa_select_temp_bytes(int queries, int buckets, size_t* bytes);
+int lsa_select(const float* query, const float* centroids, const int32_t* members,
+               const int32_t* positions, int queries, int buckets,
+               int64_t* keys_in, int64_t* keys_out,
+               int32_t* offsets, void* temporary, size_t temporary_bytes,
+               int32_t* selected, int32_t* cells, int32_t* steps, void* stream);
+// Scratch floats per query for Strata's unchanged native paged INT8 attention.
+size_t lsa_attention_scratch_floats(void);
+int lsa_attention(const float* query, const int8_t* k, const int8_t* v,
+                  const uint16_t* k_scale, const uint16_t* v_scale,
+                  const int32_t* page_table, int page_size, int queries,
+                  const int32_t* cells, const int32_t* steps,
+                  float* scratch, float* output, void* stream);
+#ifdef __cplusplus
+}
+#endif
diff --git a/include/strata/lsa/maps.hpp b/include/strata/lsa/maps.hpp
new file mode 100644
index 00000000..9672d995
--- /dev/null
+++ b/include/strata/lsa/maps.hpp
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::lsa {
+
+inline constexpr uint32_t kInputDim = 384;
+inline constexpr uint32_t kIndexDim = 64;
+inline constexpr uint32_t kLayerCount = 12;
+inline constexpr uint32_t kMapVersion = 1;
+inline constexpr uint64_t kMapHeaderBytes = 96;
+inline constexpr uint64_t kMatrixValues = uint64_t{kInputDim} * kIndexDim;
+inline constexpr uint64_t kMapRecordBytes = 16 + 2 * kMatrixValues * 4;
+inline constexpr uint64_t kMapFileBytes = kMapHeaderBytes + kLayerCount * kMapRecordBytes;
+
+// Row-major [384,64]. Inputs are two concatenated, 192-coordinate nonrotary
+// key heads, or sums of each head's twelve grouped queries. Temperature is
+// separate from the maps; projected rows are normalized by the indexer.
+struct LayerMap {
+    int32_t layer = -1;
+    float temperature = 0;
+    std::vector<float> query;
+    std::vector<float> key;
+};
+
+struct Maps {
+    std::array<LayerMap, kLayerCount> layers;
+    // Nonserialized cache identity over every exact byte validated by load_maps.
+    // FNV-1a 64 matches the existing 64-bit identity strength; not authentication.
+    uint64_t artifact_fingerprint = 0;
+    // Provenance identifiers of the original .pt and JSON files. They do not
+    // authenticate this file: the caller must pin the native file's SHA-256.
+    std::array<uint8_t, 32> source_weights_sha256{};
+    std::array<uint8_t, 32> source_metadata_sha256{};
+};
+
+// An explicitly invoked, CPU-only loader. No process-global state, allocation
+// on a device, or serving/default-path change. Failure leaves `out` unchanged.
+// The native format is fixed little-endian IEEE754 binary32, version 1.
+bool load_maps(const std::string& path, Maps& out, std::string& error);
+
+}  // namespace strata::lsa
diff --git a/include/strata/lsa/runtime.hpp b/include/strata/lsa/runtime.hpp
new file mode 100644
index 00000000..df6d3ef9
--- /dev/null
+++ b/include/strata/lsa/runtime.hpp
@@ -0,0 +1,93 @@
+#pragma once
+
+#include "strata/kernels/qsa_decode_attn.hpp"
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace strata::lsa {
+
+// Opt-in CUDA runtime state. Every pointer is carved from the owning QSA arena
+// before graph capture; no allocation, host readback or pointer changes happen
+// during a forward. Full projected history preserves accepted prefixes across
+// speculative rejection. Future rows are overwritten before becoming visible.
+struct RuntimeState {
+    int capacity = 0;
+    int buckets = 0;
+    int physical_pages = 0;
+    int page_size = 4;
+    int model_layer = -1;
+    float* history = nullptr;        // [capacity,64] FP32 normalized projected K
+    float* centroids = nullptr;      // [buckets,64] BF16-rounded FP32
+    int32_t* members = nullptr;      // [buckets,16]
+    float* key_row = nullptr;        // [64]
+    float* query_row = nullptr;      // [64]
+    int64_t* keys_in = nullptr;      // [buckets]
+    int64_t* keys_out = nullptr;     // [buckets]
+    int32_t* offsets = nullptr;     // [2]
+    int32_t* selected = nullptr;    // [385]
+    int32_t* cells = nullptr;       // [1540]
+    int32_t* steps = nullptr;       // [4], private LSA-width record
+    void* sort_temporary = nullptr;
+    size_t sort_bytes = 0;
+    void* ward_scratch = nullptr;   // sticky error and closure diagnostics
+    size_t arena_bytes = 0;
+};
+
+// One workspace per Prefill object, shared by its serial QSA layers. The model
+// planner prices it with the prompt scratch region before expert allocation.
+// It is never copied into each resident conversation/layer RuntimeState.
+struct RuntimePrefillScratch {
+    int queries = 0;
+    int buckets = 0;
+    float* query_rows = nullptr;    // [queries,64]
+    int32_t* positions = nullptr;  // [queries]
+    int64_t* keys_in = nullptr;    // [queries,buckets]
+    int64_t* keys_out = nullptr;
+    int32_t* offsets = nullptr;   // [queries+1]
+    int32_t* selected = nullptr;  // [queries,385]
+    int32_t* cells = nullptr;     // [queries,1540]
+    int32_t* steps = nullptr;     // [queries,4]
+    void* sort_temporary = nullptr;
+    size_t sort_bytes = 0;
+    size_t arena_bytes = 0;
+};
+
+// Call after selecting the CUDA device and before arena pricing. An explicit
+// incompatible/missing map refuses startup. No environment opt-in leaves the
+// existing inference route untouched. Configuration is immutable thereafter.
+bool runtime_configure_from_env(std::string& error);
+bool runtime_enabled();
+const std::string& runtime_map_path();
+uint64_t runtime_map_identity();
+size_t runtime_state_bytes(int64_t capacity);
+bool runtime_state_init(RuntimeState& state, int64_t capacity, int physical_pages,
+                        int page_size, void* arena, size_t arena_bytes, std::string& error);
+void runtime_zero(const RuntimeState& state, void* stream);
+size_t runtime_prefill_scratch_bytes(int64_t capacity, int queries = 128);
+bool runtime_prefill_scratch_init(RuntimePrefillScratch& scratch, int64_t capacity, int queries,
+                                 void* arena, size_t arena_bytes, std::string& error);
+
+bool runtime_step(const RuntimeState& state, int model_layer,
+                  const strata::kernels::QsaAttnPools& pools, const float* query,
+                  int32_t* step, int32_t* ids, int64_t cap, void* stream, std::string& error);
+bool runtime_prefill(const RuntimeState& state, int model_layer,
+                     const strata::kernels::QsaAttnPools& pools, const float* queries,
+                     int64_t start, int64_t count, int32_t* steps, int64_t step_stride,
+                     int32_t* ids, int64_t cap, void* stream, std::string& error,
+                     const RuntimePrefillScratch* scratch = nullptr);
+
+// Outside graph capture only. Restored INT8 KV is authoritative; rebuilding
+// derives fresh maps/clusters, so no LSA bytes are trusted from old snapshots.
+bool runtime_rebuild(const RuntimeState& state, const strata::kernels::QsaAttnPools& pools,
+                     int64_t tokens, std::string& error);
+// Ordered on stream. Copies the accepted prefix plus closed block data only;
+// callers must order this after any nonblocking KV copies themselves.
+bool runtime_copy(const RuntimeState& from, const RuntimeState& to, int64_t tokens,
+                  void* stream, std::string& error);
+// Outside capture: synchronize the device and report Ward diagnostics. A failed
+// closure also traps on device before inference can consume its bucket output.
+bool runtime_check(const RuntimeState& state, std::string& error);
+bool runtime_stats(const RuntimeState& state, int32_t (&values)[4], std::string& error);
+
+} // namespace strata::lsa
diff --git a/include/strata/lsa/ward.hpp b/include/strata/lsa/ward.hpp
new file mode 100644
index 00000000..29865268
--- /dev/null
+++ b/include/strata/lsa/ward.hpp
@@ -0,0 +1,41 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+namespace strata::lsa {
+// Native spherical Ward closure for the pinned Flash-Next LSA geometry:
+// 512 FP32 normalized projected keys of64 dims; consecutive pools of4;
+// mutual-cheapest Ward rounds128->64, max16 original keys/bucket.
+// Output arrays are indexed by absolute512-token block:
+// centroids [ceil(capacity/512),64,64] FP32 storage of BF16-rounded unit rows;
+// members [ceil(capacity/512),64,16] absolute token IDs, ascending, -1 padded.
+//
+// Positive capacities below512 are valid for step calls: no complete block
+// can close, so valid positions are no-ops. Range calls require complete blocks.
+// Caller owns all storage and an explicit nondefault CUDA stream. No allocation,
+// host readback, synchronization or position-dependent host launch occurs.
+// Scratch is16 bytes, aligned for int32 and zero-initialized before first use:
+// [sticky_error, completed_closures, max_rounds, reserved]. Error codes:
+// -1 invalid device position; -2 nonfinite input/arithmetic; -3 Ward stalled;
+// -4 invalid final partition. A skipped nonboundary step does not clear errors.
+// Inspect sticky_error at the enclosing request's validation boundary. Do not
+// use a failed closure's zero centroids and -1 members as a successful index.
+std::size_t ward_scratch_bytes();
+int ward_close_step(const float* history, const int32_t* position, int capacity,
+                    float* centroids, int32_t* members, void* scratch, void* stream);
+// Uncaptured prefill: first_block and block_count name fully projected blocks.
+// Graph capture is also legal when these host bounds are fixed for that graph.
+int ward_close_range(const float* history, int capacity, int first_block, int block_count,
+                     float* centroids, int32_t* members, void* scratch, void* stream);
