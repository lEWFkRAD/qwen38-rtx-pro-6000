+            target_include_directories(strata_lsa_cuda PRIVATE "${cuda_include}/cccl")
+        endif()
+    endforeach()
+    target_link_libraries(strata_lsa_cuda PRIVATE strata_lsa CUDA::cudart)
+    set_target_properties(strata_lsa_cuda PROPERTIES
+        CUDA_STANDARD 17
+        CUDA_STANDARD_REQUIRED ON
+        CXX_STANDARD 17
+        CXX_STANDARD_REQUIRED ON)
+endif()
diff --git a/src/lsa/cache_state.cpp b/src/lsa/cache_state.cpp
new file mode 100644
index 00000000..c45d2c8e
--- /dev/null
+++ b/src/lsa/cache_state.cpp
@@ -0,0 +1,132 @@
+#include "strata/lsa/cache_state.hpp"
+
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+
+namespace strata::lsa {
+
+uint32_t CacheState::layer_ordinal(uint32_t layer) {
+    if (layer < 3 || layer > 47 || (layer - 3) % 4 != 0)
+        throw std::invalid_argument("LSA requires QSA model layers 3,7,...,47");
+    return (layer - 3) / 4;
+}
+
+CacheState::Slot& CacheState::slot_at(uint32_t slot) {
+    if (slot >= kSlots) throw std::out_of_range("LSA slot is outside the eight-slot capacity");
+    return slots_[slot];
+}
+
+const CacheState::Slot& CacheState::slot_at(uint32_t slot) const {
+    if (slot >= kSlots) throw std::out_of_range("LSA slot is outside the eight-slot capacity");
+    return slots_[slot];
+}
+
+const CacheState::Slot& CacheState::live(const Ticket& ticket) const {
+    const Slot& slot = slot_at(ticket.slot);
+    if (!slot.open || slot.generation != ticket.generation || slot.committed != ticket.base_tokens)
+        throw std::logic_error("LSA transaction ticket is stale or has the wrong committed prefix");
+    return slot;
+}
+
+CacheState::Slot& CacheState::live(const Ticket& ticket) {
+    (void) static_cast<const CacheState*>(this)->live(ticket);
+    return slots_[ticket.slot];
+}
+
+void CacheState::bump(Slot& slot) {
+    if (slot.generation == std::numeric_limits<uint64_t>::max())
+        throw std::overflow_error("LSA slot generation exhausted");
+    ++slot.generation;
+}
+
+CacheState::Ticket CacheState::begin(uint32_t id) {
+    Slot& slot = slot_at(id);
+    if (slot.open) throw std::logic_error("LSA slot already has an open transaction");
+    bump(slot);
+    slot.open = true;
+    slot.appended.fill(0);
+    return {id, slot.generation, slot.committed};
+}
+
+CacheState::AppendRange CacheState::append(const Ticket& ticket, uint32_t layer, uint32_t count) {
+    Slot& slot = live(ticket);
+    uint32_t& appended = slot.appended[layer_ordinal(layer)];
+    const uint32_t begin_token = slot.committed + appended;
+    if (count > kContext - begin_token)
+        throw std::out_of_range("LSA append exceeds 131072-token context");
+    appended += count;
+    return {begin_token, begin_token + count, begin_token / kBlockTokens,
+            (begin_token + count) / kBlockTokens};
+}
+
+CacheState::Transition CacheState::finish(Slot& slot, uint32_t new_tokens) {
+    const uint32_t old_tokens = slot.committed;
+    // Bump first: an exhausted counter must not leave a partly mutated slot.
+    bump(slot);
+    slot.committed = new_tokens;
+    slot.open = false;
+    slot.appended.fill(0);
+    return {old_tokens, new_tokens, old_tokens / kBlockTokens, new_tokens / kBlockTokens,
+            new_tokens, new_tokens / kBlockTokens, slot.generation};
+}
+
+CacheState::Transition CacheState::accept_prefix(const Ticket& ticket, uint32_t accepted) {
+    Slot& slot = live(ticket);
+    const uint32_t appended = slot.appended[0];
+    if (!std::all_of(slot.appended.begin(), slot.appended.end(),
+                     [appended](uint32_t n) { return n == appended; }))
+        throw std::logic_error("LSA cannot commit an incomplete per-layer forward");
+    if (accepted > appended)
+        throw std::out_of_range("LSA accepted prefix exceeds the speculative tokens");
+    return finish(slot, slot.committed + accepted);
+}
+
+CacheState::Transition CacheState::reject(const Ticket& ticket) {
+    Slot& slot = live(ticket);
+    return finish(slot, slot.committed);
+}
+
+CacheState::Transition CacheState::truncate(uint32_t id, uint32_t retained) {
+    Slot& slot = slot_at(id);
+    if (retained > slot.committed)
+        throw std::out_of_range("LSA prefix reuse cannot invent uncommitted tokens");
+    return finish(slot, retained);
+}
+
+CacheState::Transition CacheState::reset(uint32_t id) { return truncate(id, 0); }
+
+uint32_t CacheState::committed_tokens(uint32_t id) const { return slot_at(id).committed; }
+uint32_t CacheState::published_blocks(uint32_t id) const { return slot_at(id).committed / kBlockTokens; }
+bool CacheState::transaction_open(uint32_t id) const { return slot_at(id).open; }
+uint64_t CacheState::generation(uint32_t id) const { return slot_at(id).generation; }
+
+uint32_t CacheState::available_tokens(const Ticket& ticket, uint32_t layer) const {
+    const Slot& slot = live(ticket);
+    return slot.committed + slot.appended[layer_ordinal(layer)];
+}
+
+CacheState::View CacheState::make_view(uint32_t committed, uint32_t available, uint32_t position) {
+    if (position >= available)
+        throw std::out_of_range("LSA query would read unavailable or rejected KV tokens");
+    const uint32_t visible = position + 1;
+    const uint32_t complete = visible / kBlockTokens;
+    const uint32_t published = std::min(committed / kBlockTokens, complete);
+    const uint32_t tail = complete * kBlockTokens;
+    const uint32_t long_end = visible > kWindowTokens ? visible - kWindowTokens : 0;
+    return {visible, complete, position / kBlockTokens, published, complete - published, tail, visible - tail,
+            long_end, long_end / kBlockTokens};
+}
+
+CacheState::View CacheState::view(uint32_t id, uint32_t layer, uint32_t position) const {
+    (void) layer_ordinal(layer);
+    const Slot& slot = slot_at(id);
+    return make_view(slot.committed, slot.committed, position);
+}
+
+CacheState::View CacheState::view(const Ticket& ticket, uint32_t layer, uint32_t position) const {
+    const Slot& slot = live(ticket);
+    return make_view(slot.committed, slot.committed + slot.appended[layer_ordinal(layer)], position);
+}
+
+} // namespace strata::lsa
diff --git a/src/lsa/cache_state_test.cpp b/src/lsa/cache_state_test.cpp
new file mode 100644
index 00000000..2386ec92
--- /dev/null
+++ b/src/lsa/cache_state_test.cpp
@@ -0,0 +1,248 @@
+#include "strata/lsa/cache_state.hpp"
+
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using State = strata::lsa::CacheState;
+namespace {
+int checks = 0;
+void require(bool condition, const char* message) {
+    ++checks;
+    if (!condition) throw std::runtime_error(message);
+}
+
+template <class Exception, class F> void throws(F fn, const char* message) {
+    ++checks;
+    try { fn(); }
+    catch (const Exception&) { return; }
+    throw std::runtime_error(message);
+}
+
+void append_all(State& state, State::Ticket ticket, uint32_t count) {
+    for (uint32_t l = 3; l <= 47; l += 4) state.append(ticket, l, count);
+}
+
+void seed(State& state, uint32_t slot, uint32_t tokens) {
+    auto ticket = state.begin(slot);
+    append_all(state, ticket, tokens);
+    state.accept_prefix(ticket, tokens);
+}
+
+void block_boundaries() {
+    State state;
+    auto first = state.begin(0);
+    append_all(state, first, 511);
+    require(state.published_blocks(0) == 0, "uncommitted 511 tokens were published");
+    auto view = state.view(first, 3, 510);
+    require(view.visible_tokens == 511 && view.complete_blocks == 0 && view.tail_tokens == 511,
+            "511-token tail was miscounted");
+    throws<std::out_of_range>([&] { state.view(0, 3, 0); }, "ordinary view saw speculative KV");
+    state.accept_prefix(first, 511);
+    auto second = state.begin(0);
+    auto range = state.append(second, 3, 1);
+    require(range.begin_token == 511 && range.end_token == 512 && range.first_new_block == 0 &&
+            range.end_complete_block == 1, "512th token did not complete block zero");
+    view = state.view(second, 3, 511);
+    require(view.complete_blocks == 1 && view.provisional_blocks == 1 && view.published_blocks == 0,
+            "newly completed block escaped speculative quarantine");
+    for (uint32_t l = 7; l <= 47; l += 4) state.append(second, l, 1);
+    auto commit = state.accept_prefix(second, 1);
+    require(commit.published_blocks_before == 0 && commit.published_blocks_after == 1 &&
+            commit.discard_from_block == 1, "completed accepted block was not retained");
+    auto third = state.begin(0);
+    append_all(state, third, 1);
+    view = state.view(third, 47, 512);
+    require(view.visible_tokens == 513 && view.tail_begin == 512 && view.tail_tokens == 1 &&
+            view.published_blocks == 1 && view.provisional_blocks == 0 && view.long_range_end == 1,
+            "513-token view used wrong causal or local-window bounds");
+    state.reject(third);
+    require(state.committed_tokens(0) == 512 && state.published_blocks(0) == 1,
+            "reject after boundary changed committed blocks");
+}
+
+void partial_accept_and_replay() {
+    State state;
+    seed(state, 0, 509);
+    auto candidate = state.begin(0);
+    append_all(state, candidate, 8);
+    auto plan = state.accept_prefix(candidate, 3);
+    require(plan.old_tokens == 509 && plan.new_tokens == 512 && plan.discard_from_token == 512 &&
+            plan.discard_from_block == 1 && plan.published_blocks_after == 1,
+            "partial acceptance retained rejected token or block state");
+    throws<std::logic_error>([&] { state.available_tokens(candidate, 3); }, "accepted ticket remained valid");
+    throws<std::out_of_range>([&] { state.view(0, 3, 512); }, "rejected suffix was visible after acceptance");
+    auto replay = state.begin(0);
+    auto range = state.append(replay, 3, 1);
+    require(range.begin_token == 512 && range.end_token == 513, "replay appended past rejected suffix");
+    require(state.available_tokens(replay, 3) == 513 && state.available_tokens(replay, 7) == 512,
+            "a layer saw another layer's unexecuted append");
+    throws<std::out_of_range>([&] { state.view(replay, 7, 512); }, "later layer saw unappended KV");
+    auto reject = state.reject(replay); // intentionally incomplete per-layer forward
+    require(reject.new_tokens == 512 && !state.transaction_open(0), "incomplete forward could not be rejected");
+    throws<std::logic_error>([&] { state.append(replay, 3, 1); }, "rejected ticket allowed a later append");
+}
+
+void causal_queries_with_chunk_appended_first() {
+    State state;
+    auto ticket = state.begin(0);
+    append_all(state, ticket, 4096);
+    auto early = state.view(ticket, 27, 600);
+    auto late = state.view(ticket, 27, 4095);
+    require(early.visible_tokens == 601 && early.complete_blocks == 1 && early.provisional_blocks == 1 &&
+            early.long_range_end == 89, "prefill query saw future chunk keys");
+    require(late.visible_tokens == 4096 && late.complete_blocks == 8 && late.long_range_end == 3584 &&
+            late.long_range_complete_blocks == 7, "large speculative chunk lost its causal provisional view");
+    state.accept_prefix(ticket, 513);
+    auto next = state.begin(0);
+    append_all(state, next, 1);
+    auto now = state.view(next, 27, 513);
+    require(now.complete_blocks == 1 && now.tail_tokens == 2 && now.published_blocks == 1,
+            "accepted prefix inherited discarded speculative clusters");
+    throws<std::logic_error>([&] { state.view(ticket, 27, 4095); }, "old chunk ticket regained access to rejected KV");
+}
+
+void selector_visibility_at_block_edges() {
+    State state;
+    auto ticket = state.begin(0);
+    append_all(state, ticket, 2048);
+    struct Boundary {
+        uint32_t position;
+        uint32_t complete;
+        uint32_t selectable;
+        uint32_t long_end;
+        uint32_t wholly_long;
+    };
+    // The expected selector bounds are fixed examples of the upstream contract,
+    // including a completed current block and a block crossing the local window.
+    for (const Boundary& b : {Boundary{511, 1, 0, 0, 0}, {512, 1, 1, 1, 0},
+                              {513, 1, 1, 2, 0}, {1023, 2, 1, 512, 1},
+                              {1024, 2, 2, 513, 1}, {1535, 3, 2, 1024, 2},
+                              {1536, 3, 3, 1025, 2}}) {
+        const auto staged = state.view(ticket, 3, b.position);
+        require(staged.complete_blocks == b.complete && staged.selectable_blocks == b.selectable,
+                "selector confused completed KV with rankable blocks");
+        require(staged.long_range_end == b.long_end && staged.long_range_complete_blocks == b.wholly_long,
+                "selector lost the partially visible block at a local-window edge");
+        require(staged.published_blocks == 0 && staged.provisional_blocks == b.complete,
+                "selector visibility prematurely published speculative blocks");
+    }
+    state.accept_prefix(ticket, 2048);
+    const auto committed = state.view(0, 3, 1536);
+    require(committed.selectable_blocks == 3 && committed.long_range_complete_blocks == 2 &&
+            committed.long_range_end == 1025 && committed.published_blocks == 3,
+            "committed view suppressed the ranked block containing long-range key 1024");
+}
+
+void prefix_reuse_invalidates_partial_block() {
+    State state;
+    seed(state, 2, 1537);
+    auto ticket = state.begin(2);
+    append_all(state, ticket, 16);
+    auto trim = state.truncate(2, 511);
+    require(trim.old_tokens == 1537 && trim.new_tokens == 511 && trim.discard_from_token == 511 &&
+            trim.discard_from_block == 0 && state.published_blocks(2) == 0,
+            "trim kept a block with a discarded suffix");
+    throws<std::logic_error>([&] { state.append(ticket, 3, 1); }, "prefix trim did not invalidate open ticket");
+    auto next = state.begin(2);
+    append_all(state, next, 513);
+    auto commit = state.accept_prefix(next, 513);
+    require(commit.new_tokens == 1024 && commit.published_blocks_after == 2,
+            "reuse failed to rebuild boundary-spanning blocks");
+    trim = state.truncate(2, 512);
+    require(trim.discard_from_block == 1 && state.published_blocks(2) == 1,
+            "exact-block trim discarded or retained wrong block");
+    auto revision = state.generation(2);
+    state.reset(2);
+    require(state.committed_tokens(2) == 0 && state.generation(2) > revision,
+            "reset did not invalidate sequence cache identity");
+}
+
+void slots_and_layers_remain_independent() {
+    State state;
+    for (uint32_t slot = 0; slot < State::kSlots; ++slot) seed(state, slot, slot * 512 + 1);
+    auto a = state.begin(0);
+    auto b = state.begin(7);
+    append_all(state, a, 4);
+    state.append(b, 47, 8);
+    require(state.available_tokens(b, 47) == 3593 && state.available_tokens(b, 3) == 3585,
+            "per-layer stage state leaked");
+    state.reject(a);
+    require(state.transaction_open(7) && state.available_tokens(b, 47) == 3593,
+            "one slot's rejection invalidated another slot");
+    for (uint32_t slot = 1; slot < 7; ++slot)
+        require(state.committed_tokens(slot) == slot * 512 + 1,
+                "transaction changed an unrelated committed slot");
+    state.reset(0);
+    require(state.available_tokens(b, 47) == 3593, "one slot's reset invalidated another slot");
+    state.reject(b);
+}
+
+void invalid_mutations_are_atomic() {
+    State state;
+    auto ticket = state.begin(0);
+    throws<std::logic_error>([&] { state.begin(0); }, "nested transaction accepted");
+    state.append(ticket, 3, 2);
+    throws<std::logic_error>([&] { state.accept_prefix(ticket, 1); }, "incomplete forward committed");
+    require(state.transaction_open(0) && state.committed_tokens(0) == 0 &&
+            state.available_tokens(ticket, 3) == 2, "failed commit mutated slot");
+    for (uint32_t l = 7; l <= 47; l += 4) state.append(ticket, l, 2);
+    throws<std::out_of_range>([&] { state.accept_prefix(ticket, 3); }, "accepted unavailable tokens");
+    throws<std::out_of_range>([&] { state.truncate(0, 1); }, "prefix reuse invented committed KV");
+    require(state.transaction_open(0) && state.available_tokens(ticket, 3) == 2,
+            "failed truncate changed live transaction");
+    State::Ticket forged = ticket;
+    ++forged.base_tokens;
+    throws<std::logic_error>([&] { state.append(forged, 3, 1); }, "ticket with wrong prefix was accepted");
+    state.reject(ticket);
+    auto fresh = state.begin(0);
+    require(fresh.generation != ticket.generation, "new transaction reused old ticket generation");
+    throws<std::logic_error>([&] { state.reject(ticket); }, "old ticket rejected a newer transaction");
+    require(state.transaction_open(0), "stale mutation terminated new transaction");
+    state.reject(fresh);
+}
+
+void limits_and_layer_geometry() {
+    State state;
+    require(State::kInputDim == 384 && State::kIndexDim == 64 && State::kLayers == 12 && State::kSlots == 8,
+            "learned-map geometry drifted");
+    for (uint32_t ordinal = 0; ordinal < 12; ++ordinal)
+        require(State::layer_ordinal(3 + 4 * ordinal) == ordinal, "QSA layer ordinal mismatch");
+    for (uint32_t bad : {0u, 2u, 4u, 48u, UINT32_MAX})
+        throws<std::invalid_argument>([&] { State::layer_ordinal(bad); }, "non-QSA layer accepted");
+    throws<std::out_of_range>([&] { state.begin(8); }, "ninth slot accepted");
+    seed(state, 0, State::kContext - 1);
+    auto ticket = state.begin(0);
+    throws<std::out_of_range>([&] { state.append(ticket, 3, UINT32_MAX); }, "overflow append accepted");
+    require(state.available_tokens(ticket, 3) == State::kContext - 1, "overflow append mutated count");
+    append_all(state, ticket, 1);
+    state.accept_prefix(ticket, 1);
+    require(state.committed_tokens(0) == State::kContext && state.published_blocks(0) == 256,
+            "full context was not representable");
+    auto full = state.begin(0);
+    throws<std::out_of_range>([&] { state.append(full, 3, 1); }, "context overflow accepted");
+    require(state.view(0, 47, State::kContext - 1).visible_tokens == State::kContext,
+            "last context token was not visible");
+    throws<std::out_of_range>([&] { state.view(full, 47, State::kContext); }, "past-capacity query accepted");
+    state.reject(full);
+}
+} // namespace
+
+int main() {
+    try {
+        block_boundaries();
+        partial_accept_and_replay();
+        causal_queries_with_chunk_appended_first();
+        selector_visibility_at_block_edges();
+        prefix_reuse_invalidates_partial_block();
+        slots_and_layers_remain_independent();
+        invalid_mutations_are_atomic();
+        limits_and_layer_geometry();
+        std::cout << "LSA cache state: " << checks << " checks passed\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "LSA cache state failed after " << checks << " checks: " << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/lsa/cuda_adapter.cu b/src/lsa/cuda_adapter.cu
new file mode 100644
index 00000000..197dfaec
--- /dev/null
+++ b/src/lsa/cuda_adapter.cu
@@ -0,0 +1,273 @@
+#include "strata/lsa/cuda_adapter.h"
+#include "strata/lsa/maps.hpp"
+#include "strata/kernels/qsa_decode_attn.hpp"
+#include <cuda_runtime.h>
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <math_constants.h>
+#include <cub/device/device_segmented_radix_sort.cuh>
+#include <cub/block/block_scan.cuh>
+#include <cmath>
+#include <climits>
+#include <cstdio>
+#include <memory>
+#include <string>
+
+namespace {
+constexpr int kDim=64, kInput=384, kTopP=385, kTopK=1024, kWindow=512, kSink=4;
+constexpr int kWidth=kTopK+kWindow+kSink;
+struct MapHandle {
+    float* data=nullptr;
+    float temperature[12]={};
+    uint64_t identity=0;
+    ~MapHandle(){if(data) cudaFree(data);}
+};
+int ordinal(int layer){return layer>=3 && layer<=47 && (layer-3)%4==0?(layer-3)/4:-1;}
+
+__device__ float sum_warp(float value) {
+    for(int delta=16;delta;delta>>=1) value+=__shfl_xor_sync(0xffffffff,value,delta);
+    return value;
+}
+template<bool Query> __global__ void project(const int8_t* codes,const uint16_t* scales,
+ const int32_t* table,int physical_pages,int page_size,int start,const int32_t* positions,const float* q,
+ const float* map,float* out) {
+    const int row=blockIdx.x,d=threadIdx.x;
+    __shared__ float inputs[kInput];
+    __shared__ float norms[2];
+    // Gather each of the 384 input features once. Its original head-sum or
+    // dequantization arithmetic is unchanged; each output keeps its serial
+    // 384-term multiplication/addition order after this shared staging barrier.
+    for(int f=d;f<kInput;f+=kDim) {
+        const int head=f/192,coordinate=64+f%192;
+        float x=0;
+        if constexpr(Query) {
+            for(int group=0;group<12;++group)
+                x+=q[((size_t)row*24+head*12+group)*256+coordinate];
+        } else {
+            const int position=positions?positions[row]:start+row;
+            const int page=position>=0 && position<131072 && position/page_size<physical_pages
+                ?table[position/page_size]:-1;
+            if(page>=0 && page<physical_pages) {
+                const size_t r=((size_t)page*2+head)*page_size+position%page_size;
+                x=(float)codes[r*256+coordinate]*__half2float(__ushort_as_half(scales[r*4+coordinate/64]));
+            }
+        }
+        inputs[f]=x;
+    }
+    __syncthreads();
+    float acc=0;
+    for(int f=0;f<kInput;++f)
+        acc=__fadd_rn(acc,__fmul_rn(inputs[f],map[f*kDim+d]));
+    const float n=sum_warp(acc*acc);
+    if((d&31)==0) norms[d/32]=n;
+    __syncthreads();
+    const float denominator=fmaxf(sqrtf(norms[0]+norms[1]),1e-12f);
+    float value=acc/denominator;
+    if constexpr(Query) value=__bfloat162float(__float2bfloat16_rn(value));
+    out[(size_t)row*kDim+d]=value;
+}
+
+__global__ void score(const float* query,const float* centroids,const int32_t* positions,
+ int buckets,int64_t* keys) {
+    const int bucket=blockIdx.x*8+threadIdx.x/32,row=blockIdx.y,lane=threadIdx.x%32;
+    if(bucket>=buckets) return;
+    const int pos=positions[row],visible=pos>=0 && pos<131072 ? min((pos/512)*64,buckets):0;
+    float dot=0;
+    if(bucket<visible) {
+        dot=query[(size_t)row*64+lane]*centroids[(size_t)bucket*64+lane];
+        dot+=query[(size_t)row*64+lane+32]*centroids[(size_t)bucket*64+lane+32];
+    }
+    dot=sum_warp(dot);
+    if(lane==0) {
+        int32_t ordered=__float_as_int(dot);
+        if(ordered<0) ordered^=0x7fffffff;
+        const uint64_t packed=((uint64_t)(uint32_t)ordered<<32)|(uint32_t)(0x7fffffff-bucket);
+        keys[(size_t)row*buckets+bucket]=bucket<visible && isfinite(dot)?(int64_t)packed:LLONG_MIN;
+    }
+}
+__global__ void fill_offsets(int32_t* offsets,const int32_t* positions,int queries,int buckets) {
+    if(queries==1) {
+        // Captured decode keeps capacity-sized storage and launch bounds, but
+        // only its causal prefix participates in the segmented sort. The end
+        // offset is read from device position on every graph replay, including
+        // zero-visible prefixes. CUB accepts an empty segment without reading it.
+        if(threadIdx.x==0) offsets[0]=0;
+        if(threadIdx.x==1) {
+            const int pos=positions[0];
+            offsets[1]=pos>=0 && pos<131072?min((pos/512)*64,buckets):0;
+        }
+    } else if(threadIdx.x<=queries) offsets[threadIdx.x]=threadIdx.x*buckets;
+}
+
+// A CTA walks 256-member tiles in score-ranked bucket/member order. Exclusive
+// integer ranks preserve the exact serial expansion while independent loads,
+// initialization and local-window writes run in parallel. No score math changes.
+__global__ void expand(const int64_t* sorted,const int32_t* members,const int32_t* positions,
+ int buckets,int32_t* selected,int32_t* cells,int32_t* steps) {
+    constexpr int Threads=256,MembersPerBucket=16,BucketsPerTile=Threads/MembersPerBucket;
+    using Scan=cub::BlockScan<int,Threads>;
+    __shared__ Scan::TempStorage scan;
+    __shared__ int filled;
+    const int row=blockIdx.x,pos=positions[row],tid=threadIdx.x;
+    const bool valid_position=pos>=0 && pos<131072;
+    const int visible=valid_position?min((pos/512)*64,buckets):0;
+    int32_t* out=cells+(size_t)row*kWidth;
+    int32_t* picks=selected+(size_t)row*kTopP;
+    for(int j=tid;j<kWidth;j+=Threads) out[j]=-1;
+    // Publish every selected bucket even when expansion reaches 1024 keys early.
+    for(int j=tid;j<kTopP;j+=Threads) {
+        int bucket=-1;
+        if(j<min(kTopP,visible)) {
+            const int64_t key=sorted[(size_t)row*buckets+j];
+            if(key!=LLONG_MIN) {
+                const int decoded=0x7fffffff-(int)(key&0xffffffff);
+                if(decoded>=0 && decoded<visible) bucket=decoded;
+            }
+        }
+        picks[j]=bucket;
+    }
+    if(tid==0) filled=0;
+    __syncthreads();
+    int window_count=0,sink_count=0;
+    if(valid_position) {
+        const int window_start=max(0,pos+1-kWindow);
+        for(int first=0;first<min(kTopP,visible) && filled<kTopK;first+=BucketsPerTile) {
+            const int pick=first+tid/MembersPerBucket;
+            const int bucket=pick<kTopP?picks[pick]:-1;
+            const int id=bucket>=0?members[(size_t)bucket*MembersPerBucket+tid%MembersPerBucket]:-1;
+            const int keep=id>=kSink && id<window_start;
+            int prefix=0,total=0;
+            Scan(scan).ExclusiveSum(keep,prefix,total);
+            const int at=filled+prefix;
+            if(keep && at<kTopK) out[at]=id;
+            // Reusing scan storage and advancing the shared base both wait for
+            // all threads, including the tile that crosses the 1024-key budget.
+            __syncthreads();
+            if(tid==0) filled=min(kTopK,filled+total);
+            __syncthreads();
+        }
+        window_count=pos+1-window_start;
+        sink_count=min(kSink,window_start);
+        for(int j=tid;j<window_count;j+=Threads) out[filled+j]=window_start+j;
+        if(tid<sink_count) out[filled+window_count+tid]=tid;
+    }
+    if(tid==0) {
+        steps[row*4]=pos;
+        steps[row*4+1]=valid_position?pos+1:0;
+        steps[row*4+2]=valid_position?(pos+1)/4:0;
+        steps[row*4+3]=filled+window_count+sink_count;
+    }
+}
+bool shape(int queries,int buckets) {
+    return queries>0 && queries<=128 && buckets>0 && buckets<=16384 && buckets%64==0;
+}
+}
+extern "C" void* lsa_maps_open(const char* path,char* error,size_t capacity) {
+    auto fail=[&](const std::string& message)->void* {
+        if(error && capacity) std::snprintf(error,capacity,"%s",message.c_str());
+        return nullptr;
+    };
+    if(error && capacity) error[0]=0;
+    if(!path) return fail("missing LSA map path");
+    try {
+        strata::lsa::Maps maps;std::string message;
+        if(!strata::lsa::load_maps(path,maps,message)) return fail(message);
+        auto handle=std::make_unique<MapHandle>();
+        handle->identity=maps.artifact_fingerprint;
+        auto code=cudaMalloc((void**)&handle->data,24*384*64*sizeof(float));
+        if(code!=cudaSuccess) return fail(cudaGetErrorString(code));
+        for(int i=0;i<12;++i) {
+            handle->temperature[i]=maps.layers[i].temperature;
+            for(int key=0;key<2;++key) {
+                const auto& matrix=key?maps.layers[i].key:maps.layers[i].query;
+                code=cudaMemcpy(handle->data+(i*2+key)*384*64,matrix.data(),384*64*sizeof(float),cudaMemcpyHostToDevice);
+                if(code!=cudaSuccess) return fail(cudaGetErrorString(code));
+            }
+        }
+        // Pageable H2D copies may return after staging. The first consumer can
+        // use a nonblocking stream, so publish only fully uploaded weights.
+        code=cudaStreamSynchronize(nullptr);
+        if(code!=cudaSuccess) return fail(cudaGetErrorString(code));
+        return handle.release();
+    } catch(const std::exception& ex){return fail(ex.what());}
+}
+extern "C" const float* lsa_maps_query(void* pointer,int layer) {
+    auto* h=(MapHandle*)pointer;const int i=ordinal(layer);
+    return h && i>=0?h->data+i*2*384*64:nullptr;
+}
+extern "C" const float* lsa_maps_key(void* pointer,int layer) {
+    auto* h=(MapHandle*)pointer;const int i=ordinal(layer);
+    return h && i>=0?h->data+(i*2+1)*384*64:nullptr;
+}
+extern "C" float lsa_maps_temperature(void* pointer,int layer) {
+    auto* h=(MapHandle*)pointer;const int i=ordinal(layer);
+    return h && i>=0?h->temperature[i]:NAN;
+}
+extern "C" uint64_t lsa_maps_identity(void* pointer) {
+    const auto* h=(const MapHandle*)pointer;
+    return h?h->identity:0;
+}
+extern "C" void lsa_maps_close(void* pointer){delete (MapHandle*)pointer;}
+extern "C" int lsa_project_keys(const int8_t* codes,const uint16_t* scales,const int32_t* table,
+ int physical_pages,int page_size,int start,int count,const float* map,float* output,void* stream) {
+    if(!codes||!scales||!table||!map||!output||!stream||physical_pages<=0||physical_pages>131072||
+       page_size<=0||page_size>512||start<0||count<=0||start>131072-count||
+       (int64_t)start+count>(int64_t)physical_pages*page_size)
+        return cudaErrorInvalidValue;
+    project<false><<<count,64,0,(cudaStream_t)stream>>>(codes,scales,table,physical_pages,page_size,start,nullptr,nullptr,map,output);
+    return cudaGetLastError();
+}
+extern "C" int lsa_project_key_steps(const int8_t* codes,const uint16_t* scales,const int32_t* table,
+ int physical_pages,int page_size,const int32_t* positions,int count,const float* map,float* output,void* stream) {
+    if(!codes||!scales||!table||!map||!output||!stream||!positions||physical_pages<=0||physical_pages>131072||
+       page_size<=0||page_size>512||count<=0||count>128) return cudaErrorInvalidValue;
+    project<false><<<count,64,0,(cudaStream_t)stream>>>(codes,scales,table,physical_pages,page_size,0,positions,nullptr,map,output);
+    return cudaGetLastError();
+}
+extern "C" int lsa_project_queries(const float* query,int count,const float* map,float* output,void* stream) {
+    if(!query||!map||!output||!stream||count<=0||count>128) return cudaErrorInvalidValue;
+    project<true><<<count,64,0,(cudaStream_t)stream>>>(nullptr,nullptr,nullptr,0,0,0,nullptr,query,map,output);
+    return cudaGetLastError();
+}
+extern "C" int lsa_select_temp_bytes(int queries,int buckets,size_t* bytes) {
+    if(!bytes||!shape(queries,buckets)) return cudaErrorInvalidValue;
+    *bytes=0;
+    return cub::DeviceSegmentedRadixSort::SortKeysDescending(nullptr,*bytes,
+      (int64_t*)nullptr,(int64_t*)nullptr,queries*buckets,queries,
+      (int32_t*)nullptr,(int32_t*)nullptr,0,64);
+}
+extern "C" int lsa_select(const float* query,const float* centroids,const int32_t* members,
+ const int32_t* positions,int queries,int buckets,int64_t* keys_in,int64_t* keys_out,
+ int32_t* offsets,void* temporary,size_t bytes,
+ int32_t* selected,int32_t* cells,int32_t* steps,void* stream) {
+    if(!shape(queries,buckets)||!query||!centroids||!members||!positions||!keys_in||!keys_out||
+       !offsets||!temporary||!selected||!cells||!steps||!stream)
+        return cudaErrorInvalidValue;
+    size_t needed=0;
+    auto error=(cudaError_t)lsa_select_temp_bytes(queries,buckets,&needed);
+    if(error!=cudaSuccess) return error;
+    if(bytes<needed) return cudaErrorInvalidValue;
+    auto st=(cudaStream_t)stream;
+    score<<<dim3((buckets+7)/8,queries),256,0,st>>>(query,centroids,positions,buckets,keys_in);
+    fill_offsets<<<1,256,0,st>>>(offsets,positions,queries,buckets);
+    error=cudaGetLastError();
+    if(error!=cudaSuccess) return error;
+    error=cub::DeviceSegmentedRadixSort::SortKeysDescending(temporary,bytes,keys_in,keys_out,
+      queries*buckets,queries,offsets,offsets+1,0,64,st);
+    if(error!=cudaSuccess) return error;
+    expand<<<queries,256,0,st>>>(keys_out,members,positions,buckets,selected,cells,steps);
+    return cudaGetLastError();
+}
+extern "C" size_t lsa_attention_scratch_floats(void) {
+    return strata::kernels::qsa_decode_attn_scratch_floats(kWidth,strata::kernels::qsa_real_shapes());
+}
+extern "C" int lsa_attention(const float* query,const int8_t* k,const int8_t* v,
+ const uint16_t* ks,const uint16_t* vs,const int32_t* table,int page_size,int queries,
+ const int32_t* cells,const int32_t* steps,float* scratch,float* output,void* stream) {
+    if(!query||!k||!v||!ks||!vs||!table||!cells||!steps||!scratch||!output||!stream||
+       page_size<=0||page_size>512||queries<=0||queries>128) return cudaErrorInvalidValue;
+    auto s=strata::kernels::qsa_real_shapes();s.page_size=page_size;
+    strata::kernels::QsaAttnPools p;p.k_q=k;p.v_q=v;p.k_scale=ks;p.v_scale=vs;p.page_table=table;
+    strata::kernels::qsa_decode_attn_batch(query,p,cells,steps,kWidth,s,scratch,output,queries,stream);
+    return cudaGetLastError();
+}
diff --git a/src/lsa/maps.cpp b/src/lsa/maps.cpp
new file mode 100644
index 00000000..cb66104f
--- /dev/null
+++ b/src/lsa/maps.cpp
@@ -0,0 +1,91 @@
+#include "strata/lsa/maps.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <fstream>
+#include <limits>
+#include <utility>
+
+namespace strata::lsa {
+namespace {
+
+constexpr uint8_t kMagic[8] = {'S', 'T', 'L', 'S', 'A', 'M', '0', '1'};
+
+uint32_t u32(const uint8_t* p) {
+    return uint32_t{p[0]} | (uint32_t{p[1]} << 8) | (uint32_t{p[2]} << 16) | (uint32_t{p[3]} << 24);
+}
+
+uint64_t u64(const uint8_t* p) {
+    return uint64_t{u32(p)} | (uint64_t{u32(p + 4)} << 32);
+}
+
+float f32(const uint8_t* p) {
+    const uint32_t bits = u32(p);
+    float value;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+bool fail(std::string& error, const std::string& message) {
+    error = "LSA maps: " + message;
+    return false;
+}
+
+}  // namespace
+
+bool load_maps(const std::string& path, Maps& out, std::string& error) {
+    static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559,
+                  "LSA map loader requires IEEE754 binary32");
+    std::ifstream input(path, std::ios::binary | std::ios::ate);
+    if (!input) return fail(error, "cannot open file");
+    const std::streampos size = input.tellg();
+    // Fixed geometry bounds every allocation and rejects trailing payloads.
+    if (size != std::streampos(kMapFileBytes)) return fail(error, "wrong file length (truncated or trailing bytes)");
+    input.seekg(0);
+    std::vector<uint8_t> bytes(static_cast<size_t>(kMapFileBytes));
+    if (!input.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(bytes.size())))
+        return fail(error, "cannot read complete file");
+    // A file that grew between sizing and reading is also invalid.
+    if (input.peek() != std::char_traits<char>::eof()) return fail(error, "trailing bytes");
+    const uint8_t* p = bytes.data();
+    if (!std::equal(std::begin(kMagic), std::end(kMagic), p)) return fail(error, "bad magic");
+    if (u32(p + 8) != kMapVersion) return fail(error, "unsupported version");
+    if (u32(p + 12) != kInputDim || u32(p + 16) != kIndexDim || u32(p + 20) != kLayerCount)
+        return fail(error, "wrong dimensions or layer count");
+    if (u64(p + 24) != kLayerCount * kMapRecordBytes) return fail(error, "wrong payload length");
+    Maps candidate;
+    std::copy(p + 32, p + 64, candidate.source_weights_sha256.begin());
+    std::copy(p + 64, p + 96, candidate.source_metadata_sha256.begin());
+    p += kMapHeaderBytes;
+    for (uint32_t i = 0; i < kLayerCount; ++i) {
+        auto& layer = candidate.layers[i];
+        const uint32_t expected = 3 + 4 * i;
+        if (u32(p) != expected) return fail(error, "wrong, missing, duplicated, or unordered layer");
+        if (u32(p + 4) != 0 || u32(p + 12) != 0) return fail(error, "nonzero reserved field");
+        layer.layer = static_cast<int32_t>(expected);
+        layer.temperature = f32(p + 8);
+        if (!(std::isfinite(layer.temperature) && layer.temperature > 0))
+            return fail(error, "temperature must be positive and finite");
+        p += 16;
+        for (auto* matrix : {&layer.query, &layer.key}) {
+            matrix->resize(static_cast<size_t>(kMatrixValues));
+            for (float& value : *matrix) {
+                value = f32(p);
+                if (!std::isfinite(value)) return fail(error, "matrix contains a nonfinite value");
+                p += 4;
+            }
+        }
+    }
+    uint64_t fingerprint = 14695981039346656037ULL;
+    for (const uint8_t byte : bytes) {
+        fingerprint ^= byte;
+        fingerprint *= 1099511628211ULL;
+    }
+    candidate.artifact_fingerprint = fingerprint;
+    out = std::move(candidate);
+    error.clear();
+    return true;
+}
+
+}  // namespace strata::lsa
diff --git a/src/lsa/maps_test.cpp b/src/lsa/maps_test.cpp
new file mode 100644
index 00000000..9d9fea46
--- /dev/null
+++ b/src/lsa/maps_test.cpp
@@ -0,0 +1,140 @@
+// CPU tests for the explicit learned-map interchange. No engine or CUDA calls.
+#include "strata/lsa/maps.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <limits>
+#include <string>
+#include <vector>
+
+using namespace strata::lsa;
+
+namespace {
+int failed = 0;
+int checks = 0;
+
+void check(bool ok, const char* name) {
+    ++checks;
+    if (!ok) { ++failed; std::fprintf(stderr, "FAIL %s\n", name); }
+}
+
+void put32(std::vector<uint8_t>& v, size_t offset, uint32_t n) {
+    for (int i = 0; i < 4; ++i) v[offset + i] = static_cast<uint8_t>(n >> (i * 8));
+}
+
+void putf(std::vector<uint8_t>& v, size_t offset, float f) {
+    uint32_t u;
+    std::memcpy(&u, &f, 4);
+    put32(v, offset, u);
+}
+
+std::vector<uint8_t> fixture() {
+    std::vector<uint8_t> v(static_cast<size_t>(kMapFileBytes));
+    std::memcpy(v.data(), "STLSAM01", 8);
+    put32(v, 8, 1); put32(v, 12, kInputDim); put32(v, 16, kIndexDim); put32(v, 20, kLayerCount);
+    const uint64_t payload = kMapRecordBytes * kLayerCount;
+    put32(v, 24, static_cast<uint32_t>(payload)); put32(v, 28, static_cast<uint32_t>(payload >> 32));
+    for (size_t j = 32; j < 96; ++j) v[j] = static_cast<uint8_t>(j);
+    for (uint32_t i = 0; i < kLayerCount; ++i) {
+        const size_t off = static_cast<size_t>(kMapHeaderBytes + i * kMapRecordBytes);
+        put32(v, off, 3 + 4 * i); putf(v, off + 8, 0.05f + i * 0.001f);
+        for (size_t j = 0; j < 2 * kMatrixValues; ++j) putf(v, off + 16 + j * 4, float(int(j % 127) - 63) / 128);
+    }
+    return v;
+}
+
+bool read_fixture(const std::string& path, const std::vector<uint8_t>& bytes, Maps& maps, std::string& error) {
+    { std::ofstream f(path, std::ios::binary); f.write(reinterpret_cast<const char*>(bytes.data()), bytes.size()); }
+    return load_maps(path, maps, error);
+}
+
+void rejection(const std::string& path, const std::vector<uint8_t>& bytes, const char* name) {
+    Maps maps;
+    maps.layers[0].layer = 777;
+    maps.layers[0].query = {123.0f};
+    maps.artifact_fingerprint = 456;
+    std::string error;
+    check(!read_fixture(path, bytes, maps, error) && !error.empty(), name);
+    check(maps.layers[0].layer == 777 && maps.layers[0].query == std::vector<float>{123.0f}
+          && maps.artifact_fingerprint == 456, "failure is transactional");
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 2 || argc > 3) {
+        std::fprintf(stderr, "usage: lsa_maps_test writable-fixture-path [exported-native-map]\n");
+        return 2;
+    }
+    const std::string path = argv[1];
+    auto bytes = fixture();
+    Maps maps;
+    std::string error = "stale";
+    check(read_fixture(path, bytes, maps, error) && error.empty(), "valid file");
+    check(maps.layers[0].layer == 3 && maps.layers[11].layer == 47, "complete ordered layers");
+    check(maps.layers[0].temperature == 0.05f && maps.layers[0].query[0] == -63.0f / 128, "float values exact");
+    check(maps.layers[11].key.size() == kMatrixValues && maps.source_weights_sha256[0] == 32
+          && maps.source_metadata_sha256[31] == 95, "matrices and provenance");
+    const uint64_t identity = maps.artifact_fingerprint;
+    check(identity != 0, "full artifact identity exists");
+    Maps identical;
+    check(read_fixture(path, bytes, identical, error) && identical.artifact_fingerprint == identity,
+          "unchanged bytes preserve identity");
+    // This float lies in the middle gap omitted by the legacy 1 MiB head/tail
+    // sampler. Keep geometry, provenance, length and finite-value validity.
+    const size_t middle = (bytes.size() / 2) & ~size_t(3);
+    check(middle >= (1u << 20) && middle + 4 <= bytes.size() - (1u << 20), "middle edit lies outside sampled ends");
+    auto changed = bytes;
+    putf(changed, middle, 1.25f);
+    Maps edited;
+    check(read_fixture(path, changed, edited, error) && edited.artifact_fingerprint != identity,
+          "valid finite middle edit changes full artifact identity");
+    check(edited.source_weights_sha256 == maps.source_weights_sha256 &&
+          edited.source_metadata_sha256 == maps.source_metadata_sha256, "middle identity change does not depend on provenance changes");
+    check(read_fixture(path, bytes, maps, error) && maps.artifact_fingerprint == identity,
+          "restored exact bytes restore identity");
+    auto bad = bytes; bad[0] ^= 1; rejection(path, bad, "magic");
+    bad = bytes; put32(bad, 8, 2); rejection(path, bad, "version");
+    bad = bytes; put32(bad, 12, 768); rejection(path, bad, "input dimension");
+    bad = bytes; put32(bad, 16, 128); rejection(path, bad, "index dimension");
+    bad = bytes; put32(bad, 20, 11); rejection(path, bad, "layer count");
+    bad = bytes; put32(bad, 24, 0); rejection(path, bad, "payload length");
+    bad = bytes; bad.pop_back(); rejection(path, bad, "truncation");
+    bad = bytes; bad.push_back(0); rejection(path, bad, "trailing bytes");
+    bad = bytes; put32(bad, kMapHeaderBytes + kMapRecordBytes, 3); rejection(path, bad, "duplicate layer");
+    bad = bytes; put32(bad, kMapHeaderBytes, 7); rejection(path, bad, "unordered layer");
+    bad = bytes; put32(bad, kMapHeaderBytes + 4, 1); rejection(path, bad, "reserved field");
+    bad = bytes; putf(bad, kMapHeaderBytes + 8, 0); rejection(path, bad, "zero temperature");
+    bad = bytes; putf(bad, kMapHeaderBytes + 8, -1); rejection(path, bad, "negative temperature");
+    bad = bytes; putf(bad, kMapHeaderBytes + 8, std::numeric_limits<float>::infinity()); rejection(path, bad, "infinite temperature");
+    bad = bytes; putf(bad, kMapHeaderBytes + 16, std::numeric_limits<float>::quiet_NaN()); rejection(path, bad, "NaN matrix");
+    bad = bytes; putf(bad, kMapHeaderBytes + 16 + kMatrixValues * 4, std::numeric_limits<float>::infinity());
+    rejection(path, bad, "infinite key matrix");
+    std::remove(path.c_str());
+    if (argc == 3) {
+        check(load_maps(argv[2], maps, error), "actual exported pilot maps load");
+        if (error.empty()) {
+            std::ifstream input(argv[2], std::ios::binary);
+            std::vector<uint8_t> raw(static_cast<size_t>(kMapFileBytes));
+            input.read(reinterpret_cast<char*>(raw.data()), raw.size());
+            bool exact = true;
+            for (uint32_t i = 0; i < kLayerCount; ++i) {
+                const size_t off = static_cast<size_t>(kMapHeaderBytes + i * kMapRecordBytes);
+                for (const auto* matrix : {&maps.layers[i].query, &maps.layers[i].key}) {
+                    const size_t which = matrix == &maps.layers[i].query ? 0 : 1;
+                    for (size_t j = 0; j < kMatrixValues; ++j) {
+                        const size_t p = off + 16 + which * kMatrixValues * 4 + j * 4;
+                        uint32_t bits;
+                        std::memcpy(&bits, &(*matrix)[j], 4);
+                        for (int k = 0; k < 4; ++k) exact &= raw[p + k] == static_cast<uint8_t>(bits >> (8 * k));
+                    }
+                }
+            }
+            check(exact, "all exported coefficients read bit-exactly");
+        }
+    }
+    std::printf("lsa_maps_test: %d checks, %d failed\n", checks, failed);
+    return failed ? 1 : 0;
+}
diff --git a/src/lsa/runtime.cu b/src/lsa/runtime.cu
new file mode 100644
index 00000000..77b52299
--- /dev/null
+++ b/src/lsa/runtime.cu
@@ -0,0 +1,361 @@
+#include "strata/lsa/runtime.hpp"
+#include "strata/lsa/cuda_adapter.h"
+#include "strata/lsa/ward.hpp"
+
+#include <cuda_runtime.h>
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <iterator>
+#include <mutex>
+#include <string>
+
+namespace strata::lsa {
+namespace {
+constexpr int D = 64, P = 385, W = 1540;
+void* maps_handle = nullptr; // Immutable, intentionally retained until process exit.
+bool configured = false;
+std::string maps_path;
+std::mutex configuration_lock;
+
+size_t rounded(size_t bytes) { return (bytes + 255) & ~size_t(255); }
+int bucket_capacity(int64_t capacity) { return std::max<int64_t>(1, (capacity + 511) / 512) * 64; }
+bool status(int code, const char* what, std::string& error) {
+    if (code == cudaSuccess) return true;
+    error = std::string("LSA runtime ") + what + ": " + cudaGetErrorString((cudaError_t) code);
+    return false;
+}
+bool valid_capacity(int64_t capacity) { return capacity > 0 && capacity <= 131072; }
+
+size_t bytes_for(int64_t capacity, size_t sort_bytes) {
+    const size_t buckets = bucket_capacity(capacity);
+    size_t bytes = 256; // Up to 255 bytes to align the supplied arena's first address.
+    for (size_t n : {size_t(capacity) * D * 4, buckets * D * 4, buckets * 16 * 4,
+                     size_t(D * 4), size_t(D * 4), buckets * 8, buckets * 8,
+                     size_t(2 * 4), size_t(P * 4), size_t(W * 4), size_t(4 * 4),
+                     sort_bytes, ward_scratch_bytes()}) bytes += rounded(n);
+    return bytes;
+}
+
+size_t prefill_bytes_for(int64_t capacity, int queries, size_t sort_bytes) {
+    const size_t buckets = bucket_capacity(capacity), rows = size_t(queries);
+    size_t bytes = 256;
+    for (size_t n : {rows * D * 4, rows * 4, rows * buckets * 8, rows * buckets * 8,
+                     (rows + 1) * 4, rows * P * 4, rows * W * 4, rows * 4 * 4, sort_bytes})
+        bytes += rounded(n);
+    return bytes;
+}
+
+struct Arena {
+    uintptr_t next;
+    uintptr_t end;
+    void* take(size_t bytes) {
+        next = (next + 255) & ~uintptr_t(255);
+        if (next > end || bytes > end - next) return nullptr;
+        void* pointer = reinterpret_cast<void*>(next);
+        next += rounded(bytes);
+        return pointer;
+    }
+};
+
+__global__ void store_projected(const float* row, const int32_t* step, int capacity, float* history) {
+    const int position = step[0];
+    if (position < 0 || position >= capacity) { asm volatile("trap;"); return; }
+    history[size_t(position) * D + threadIdx.x] = row[threadIdx.x];
+}
+
+__global__ void closure_guard(const int32_t* diagnostics) {
+    // Fail closed before a failed closure's cleared output can become attention.
+    // The enclosing engine synchronization surfaces a candidate CUDA failure.
+    if (*diagnostics < 0) asm volatile("trap;");
+}
+
+__global__ void publish(const int32_t* cells, const int32_t* selected_step,
+                        int32_t* ids, int cap, int32_t* step) {
+    for (int i = threadIdx.x; i < cap; i += blockDim.x) ids[i] = i < W ? cells[i] : -1;
+    if (threadIdx.x == 0) step[3] = selected_step[3];
+}
+
+__global__ void positions_from_steps(const int32_t* steps, int64_t stride, int rows,
+                                    int first_position, int32_t* positions) {
+    const int row = threadIdx.x;
+    if (row >= rows) return;
+    const int position = steps[size_t(row) * stride];
+    if (position != first_position + row) { asm volatile("trap;"); return; }
+    positions[row] = position;
+}
+
+__global__ void publish_batch(const int32_t* cells, const int32_t* selected_steps,
+                              int32_t* ids, int cap, int32_t* steps, int64_t step_stride) {
+    const int row = blockIdx.x;
+    for (int i = threadIdx.x; i < cap; i += blockDim.x)
+        ids[size_t(row) * cap + i] = i < W ? cells[size_t(row) * W + i] : -1;
+    if (threadIdx.x == 0) steps[size_t(row) * step_stride + 3] = selected_steps[row * 4 + 3];
+}
+
+bool validate(const RuntimeState& s, int layer, const strata::kernels::QsaAttnPools& pools,
+              int64_t cap, void* stream, std::string& error) {
+    if (!maps_handle || !s.history || !s.centroids || !s.members || !stream || cap < W || cap > INT32_MAX ||
+        layer < 3 || layer > 47 || (layer - 3) % 4 || s.model_layer != layer ||
+        !pools.k_q || !pools.k_scale || !pools.page_table || pools.k_q4 || pools.k_pool ||
+        !valid_capacity(s.capacity)) {
+        error = "LSA runtime: incompatible state, map layer, INT8 pool or output capacity";
+        return false;
+    }
+    return true;
+}
+
+bool select_row(const RuntimeState& s, int layer, const float* query, int32_t* step,
+                int32_t* ids, int64_t cap, void* stream, std::string& error) {
+    if (!query || !step || !ids) { error = "LSA runtime: missing query/step/selection buffer"; return false; }
+    if (!status(lsa_project_queries(query, 1, lsa_maps_query(maps_handle, layer), s.query_row, stream),
+                "query projection", error)) return false;
+    if (!status(lsa_select(s.query_row, s.centroids, s.members, step, 1, s.buckets, s.keys_in, s.keys_out,
+                           s.offsets, s.sort_temporary, s.sort_bytes, s.selected, s.cells, s.steps, stream),
+                "selection", error)) return false;
+    publish<<<1, 256, 0, (cudaStream_t) stream>>>(s.cells, s.steps, ids, (int) cap, step);
+    return status(cudaGetLastError(), "selection publication", error);
+}
+} // namespace
+
+bool runtime_configure_from_env(std::string& error) {
+    std::lock_guard<std::mutex> lock(configuration_lock);
+    const char* value = std::getenv("STRATA_LSA_MAPS");
+    const std::string requested = value ? value : "";
+    if (configured) {
+        if (requested != maps_path) { error = "LSA map configuration cannot change after startup"; return false; }
+        error.clear();
+        return true;
+    }
+    if (requested.empty()) { configured = true; error.clear(); return true; }
+    char why[1024] = {};
+    void* candidate = lsa_maps_open(requested.c_str(), why, sizeof(why));
+    if (!candidate) { error = std::string("LSA map startup refused: ") + why; return false; }
+    maps_handle = candidate;
+    maps_path = requested;
+    configured = true;
+    error.clear();
+    return true;
+}
+
+bool runtime_enabled() { return maps_handle != nullptr; }
+const std::string& runtime_map_path() { return maps_path; }
+uint64_t runtime_map_identity() { return lsa_maps_identity(maps_handle); }
+
+size_t runtime_state_bytes(int64_t capacity) {
+    if (!runtime_enabled() || !valid_capacity(capacity)) return 0;
+    size_t sort_bytes = 0;
+    if (lsa_select_temp_bytes(1, bucket_capacity(capacity), &sort_bytes) != cudaSuccess) return 0;
+    return bytes_for(capacity, sort_bytes);
+}
+
+bool runtime_state_init(RuntimeState& out, int64_t capacity, int physical_pages, int page_size,
+                        void* memory, size_t bytes, std::string& error) {
+    if (!runtime_enabled() || !valid_capacity(capacity) || !memory || physical_pages <= 0 ||
+        page_size <= 0 || page_size > 512 || int64_t(physical_pages) * page_size < capacity) {
+        error = "LSA runtime: unsupported state allocation geometry"; return false;
+    }
+    size_t sort_bytes = 0;
+    if (!status(lsa_select_temp_bytes(1, bucket_capacity(capacity), &sort_bytes), "sort sizing", error)) return false;
+    if (bytes < bytes_for(capacity, sort_bytes)) { error = "LSA runtime: undersized state arena"; return false; }
+    Arena arena{reinterpret_cast<uintptr_t>(memory), reinterpret_cast<uintptr_t>(memory) + bytes};
+    RuntimeState s;
+    s.capacity = (int) capacity; s.buckets = bucket_capacity(capacity);
+    s.physical_pages = physical_pages; s.page_size = page_size; s.sort_bytes = sort_bytes; s.arena_bytes = bytes;
+    s.history = static_cast<float*>(arena.take(size_t(capacity) * D * 4));
+    s.centroids = static_cast<float*>(arena.take(size_t(s.buckets) * D * 4));
+    s.members = static_cast<int32_t*>(arena.take(size_t(s.buckets) * 16 * 4));
+    s.key_row = static_cast<float*>(arena.take(D * 4));
+    s.query_row = static_cast<float*>(arena.take(D * 4));
+    s.keys_in = static_cast<int64_t*>(arena.take(size_t(s.buckets) * 8));
+    s.keys_out = static_cast<int64_t*>(arena.take(size_t(s.buckets) * 8));
+    s.offsets = static_cast<int32_t*>(arena.take(2 * 4));
+    s.selected = static_cast<int32_t*>(arena.take(P * 4));
+    s.cells = static_cast<int32_t*>(arena.take(W * 4));
+    s.steps = static_cast<int32_t*>(arena.take(4 * 4));
+    s.sort_temporary = arena.take(sort_bytes);
+    s.ward_scratch = arena.take(ward_scratch_bytes());
+    if (!s.ward_scratch || !s.sort_temporary) { error = "LSA runtime: state carving overflow"; return false; }
+    if (!status(cudaMemset(s.ward_scratch, 0, ward_scratch_bytes()), "state initialization", error)) return false;
+    out = s;
+    return true;
+}
+
+void runtime_zero(const RuntimeState& s, void* stream) {
+    // No reader can name unwritten projected history or unfinished blocks. A
+    // reset only clears diagnostics; later closures overwrite their whole block.
+    if (s.history) cudaMemsetAsync(s.ward_scratch, 0, ward_scratch_bytes(), (cudaStream_t) stream);
+}
+
+size_t runtime_prefill_scratch_bytes(int64_t capacity, int queries) {
+    if (!runtime_enabled() || !valid_capacity(capacity) || queries < 1 || queries > 128) return 0;
+    size_t sort_bytes = 0;
+    if (lsa_select_temp_bytes(queries, bucket_capacity(capacity), &sort_bytes) != cudaSuccess) return 0;
+    return prefill_bytes_for(capacity, queries, sort_bytes);
+}
+
+bool runtime_prefill_scratch_init(RuntimePrefillScratch& out, int64_t capacity, int queries,
+                                 void* memory, size_t bytes, std::string& error) {
+    if (!runtime_enabled() || !valid_capacity(capacity) || queries < 1 || queries > 128 || !memory) {
+        error = "LSA runtime: unsupported prefill workspace geometry"; return false;
+    }
+    size_t sort_bytes = 0;
+    if (!status(lsa_select_temp_bytes(queries, bucket_capacity(capacity), &sort_bytes),
+                "prefill sort sizing", error)) return false;
+    if (bytes < prefill_bytes_for(capacity, queries, sort_bytes)) {
+        error = "LSA runtime: undersized prefill workspace"; return false;
+    }
+    Arena arena{reinterpret_cast<uintptr_t>(memory), reinterpret_cast<uintptr_t>(memory) + bytes};
+    RuntimePrefillScratch scratch;
+    scratch.queries = queries; scratch.buckets = bucket_capacity(capacity);
+    scratch.sort_bytes = sort_bytes; scratch.arena_bytes = bytes;
+    const size_t rows = size_t(queries), buckets = size_t(scratch.buckets);
+    scratch.query_rows = static_cast<float*>(arena.take(rows * D * 4));
+    scratch.positions = static_cast<int32_t*>(arena.take(rows * 4));
+    scratch.keys_in = static_cast<int64_t*>(arena.take(rows * buckets * 8));
+    scratch.keys_out = static_cast<int64_t*>(arena.take(rows * buckets * 8));
+    scratch.offsets = static_cast<int32_t*>(arena.take((rows + 1) * 4));
+    scratch.selected = static_cast<int32_t*>(arena.take(rows * P * 4));
+    scratch.cells = static_cast<int32_t*>(arena.take(rows * W * 4));
+    scratch.steps = static_cast<int32_t*>(arena.take(rows * 4 * 4));
+    scratch.sort_temporary = arena.take(sort_bytes);
+    if (!scratch.sort_temporary) { error = "LSA runtime: prefill workspace carving overflow"; return false; }
+    out = scratch;
+    return true;
+}
+
+bool runtime_step(const RuntimeState& s, int layer, const strata::kernels::QsaAttnPools& pools,
+                  const float* query, int32_t* step, int32_t* ids, int64_t cap, void* stream, std::string& error) {
+    if (!validate(s, layer, pools, cap, stream, error) || !step) return false;
+    if (!status(lsa_project_key_steps(pools.k_q, pools.k_scale, pools.page_table, s.physical_pages, s.page_size,
+                                     step, 1, lsa_maps_key(maps_handle, layer), s.key_row, stream),
+                "key projection", error)) return false;
+    store_projected<<<1, D, 0, (cudaStream_t) stream>>>(s.key_row, step, s.capacity, s.history);
+    if (!status(cudaGetLastError(), "projected history append", error)) return false;
+    if (!status(ward_close_step(s.history, step, s.capacity, s.centroids, s.members, s.ward_scratch, stream),
+                "block closure", error)) return false;
+    closure_guard<<<1, 1, 0, (cudaStream_t) stream>>>((const int32_t*) s.ward_scratch);
+    if (!status(cudaGetLastError(), "closure guard", error)) return false;
+    return select_row(s, layer, query, step, ids, cap, stream, error);
+}
+
+bool runtime_prefill(const RuntimeState& s, int layer, const strata::kernels::QsaAttnPools& pools,
+                     const float* queries, int64_t start, int64_t count, int32_t* steps, int64_t step_stride,
+                     int32_t* ids, int64_t cap, void* stream, std::string& error,
+                     const RuntimePrefillScratch* scratch) {
+    if (!validate(s, layer, pools, cap, stream, error) || !queries || !steps || !ids ||
+        start < 0 || count < 1 || count > s.capacity || start > s.capacity - count || step_stride < 4) {
+        if (error.empty()) error = "LSA runtime: invalid prompt range or buffers";
+        return false;
+    }
+    if (!status(lsa_project_keys(pools.k_q, pools.k_scale, pools.page_table, s.physical_pages, s.page_size,
+                                (int) start, (int) count, lsa_maps_key(maps_handle, layer),
+                                s.history + size_t(start) * D, stream), "prompt key projection", error)) return false;
+    const int first = (int) (start / 512), blocks = (int) ((start + count) / 512) - first;
+    if (blocks && !status(ward_close_range(s.history, s.capacity, first, blocks, s.centroids, s.members,
+                                          s.ward_scratch, stream), "prompt block closure", error)) return false;
+    closure_guard<<<1, 1, 0, (cudaStream_t) stream>>>((const int32_t*) s.ward_scratch);
+    if (!status(cudaGetLastError(), "prompt closure guard", error)) return false;
+    if (scratch) {
+        const auto& b = *scratch;
+        if (b.queries < 1 || b.queries > 128 || b.buckets < s.buckets || !b.query_rows || !b.positions ||
+            !b.keys_in || !b.keys_out || !b.offsets || !b.selected || !b.cells || !b.steps || !b.sort_temporary) {
+            error = "LSA runtime: missing or incompatible batched prefill workspace";
+            return false;
+        }
+        for (int64_t first_row = 0; first_row < count; first_row += b.queries) {
+            const int rows = (int) std::min<int64_t>(b.queries, count - first_row);
+            const int last_position = (int) (start + first_row + rows - 1);
+            // Prompt counts are host-known outside capture. Keep the exact
+            // device causal mask per query while avoiding scans of unused
+            // future-capacity buckets. Each packed row uses this active stride.
+            const int active = std::max(64, std::min(s.buckets, (last_position / 512) * 64));
+            size_t needed = 0;
+            if (!status(lsa_select_temp_bytes(rows, active, &needed), "active prefill sort sizing", error)) return false;
+            if (needed > b.sort_bytes) { error = "LSA runtime: active sort exceeds planned prefill workspace"; return false; }
+            int32_t* original_steps = steps + first_row * step_stride;
+            positions_from_steps<<<1, 128, 0, (cudaStream_t) stream>>>(original_steps, step_stride, rows,
+                                                                       (int) (start + first_row), b.positions);
+            if (!status(cudaGetLastError(), "prefill position packing", error)) return false;
+            if (!status(lsa_project_queries(queries + size_t(first_row) * 24 * 256, rows,
+                                            lsa_maps_query(maps_handle, layer), b.query_rows, stream),
+                        "batched prompt query projection", error)) return false;
+            if (!status(lsa_select(b.query_rows, s.centroids, s.members, b.positions, rows, active,
+                                   b.keys_in, b.keys_out, b.offsets, b.sort_temporary, b.sort_bytes,
+                                   b.selected, b.cells, b.steps, stream), "batched prompt selection", error)) return false;
+            publish_batch<<<rows, 256, 0, (cudaStream_t) stream>>>(b.cells, b.steps, ids + first_row * cap,
+                                                                  (int) cap, original_steps, step_stride);
+            if (!status(cudaGetLastError(), "batched prompt selection publication", error)) return false;
+        }
+        return true;
+    }
+    for (int64_t row = 0; row < count; ++row)
+        if (!select_row(s, layer, queries + size_t(row) * 24 * 256, steps + row * step_stride,
+                         ids + row * cap, cap, stream, error)) return false;
+    return true;
+}
+
+bool runtime_stats(const RuntimeState& s, int32_t (&values)[4], std::string& error) {
+    if (!s.history) { std::fill(std::begin(values), std::end(values), 0); return true; }
+    return status(cudaDeviceSynchronize(), "statistics synchronization", error) &&
+           status(cudaMemcpy(values, s.ward_scratch, sizeof(values), cudaMemcpyDeviceToHost), "statistics read", error);
+}
+
+bool runtime_check(const RuntimeState& s, std::string& error) {
+    int32_t values[4] = {};
+    if (!runtime_stats(s, values, error)) return false;
+    if (values[0] < 0) { error = "LSA native Ward closure failed: " + std::to_string(values[0]); return false; }
+    return true;
+}
+
+bool runtime_rebuild(const RuntimeState& s, const strata::kernels::QsaAttnPools& pools,
+                     int64_t tokens, std::string& error) {
+    if (!s.history) return true;
+    if (tokens < 0 || tokens > s.capacity) { error = "LSA runtime: restored prefix exceeds capacity"; return false; }
+    cudaStream_t stream = nullptr;
+    if (!status(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking), "restore stream", error)) return false;
+    bool ok = validate(s, s.model_layer, pools, W, stream, error);
+    if (ok) ok = status(cudaMemsetAsync(s.ward_scratch, 0, ward_scratch_bytes(), stream), "restore reset", error);
+    if (ok && tokens)
+        ok = status(lsa_project_keys(pools.k_q, pools.k_scale, pools.page_table, s.physical_pages, s.page_size,
+                                     0, (int) tokens, lsa_maps_key(maps_handle, s.model_layer), s.history, stream),
+                     "restored key projection", error);
+    if (ok && tokens >= 512)
+        ok = status(ward_close_range(s.history, s.capacity, 0, (int) (tokens / 512), s.centroids, s.members,
+                                     s.ward_scratch, stream), "restored block closure", error);
+    int32_t diagnostics[4] = {};
+    if (ok) ok = status(cudaMemcpyAsync(diagnostics, s.ward_scratch, sizeof(diagnostics),
+                                       cudaMemcpyDeviceToHost, stream), "restored closure diagnostics", error);
+    if (ok) ok = status(cudaStreamSynchronize(stream), "restored cache synchronization", error);
+    const cudaError_t destroy = cudaStreamDestroy(stream);
+    if (ok) ok = status(destroy, "restore stream release", error);
+    if (ok && diagnostics[0] < 0) {
+        error = "LSA restored native Ward closure failed: " + std::to_string(diagnostics[0]);
+        ok = false;
+    }
+    return ok;
+}
+
+bool runtime_copy(const RuntimeState& from, const RuntimeState& to, int64_t tokens,
+                  void* stream, std::string& error) {
+    if (!from.history && !to.history) return true;
+    // A short-context MTP drafter can request ring_cells==0 and receive an
+    // unused, correctly priced arena. Only session-owned main QSA layers bind
+    // a map layer; the drafter still uses its own unchanged attention path.
+    if (from.model_layer < 0 && to.model_layer < 0) return true;
+    if (!from.history || !to.history || from.capacity != to.capacity || from.model_layer != to.model_layer ||
+        tokens < 0 || tokens > from.capacity) { error = "LSA runtime: incompatible copied prefix"; return false; }
+    const size_t blocks = size_t(tokens / 512), history_bytes = size_t(tokens) * D * 4;
+    const auto st = (cudaStream_t) stream;
+    auto copy = [&](void* destination, const void* source, size_t bytes) {
+        return !bytes || status(cudaMemcpyAsync(destination, source, bytes, cudaMemcpyDeviceToDevice, st),
+                                "prefix copy", error);
+    };
+    return copy(to.history, from.history, history_bytes) &&
+           copy(to.centroids, from.centroids, blocks * 64 * D * 4) &&
+           copy(to.members, from.members, blocks * 64 * 16 * 4) &&
+           copy(to.ward_scratch, from.ward_scratch, ward_scratch_bytes());
+}
+
+} // namespace strata::lsa
